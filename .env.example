# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# SQL Server 'sa' password. Must satisfy SQL Server's complexity policy (8+ chars, at least 3 of:
# uppercase, lowercase, digit, symbol).
MSSQL_SA_PASSWORD=

# Symmetric key used to sign/validate JWTs (Jwt:SigningKey). Generate a long random secret, e.g.:
#   openssl rand -base64 48
JWT_SIGNING_KEY=

# Bare public domain (no scheme, no trailing slash) the whole app is served from, e.g.
# cffvault.duckdns.org. One domain serves both Web and Api: Caddy path-routes /api/* to the Api
# container and everything else to Web, so CORS/WebAuthn origins and Caddy's TLS cert all derive
# from this single value (see Caddyfile, docker-compose.yml).
PUBLIC_DOMAIN=

# Email Caddy registers with Let's Encrypt for certificate expiry/renewal notices.
CADDY_ACME_EMAIL=

# SMTP (optional — leave SMTP_HOST empty to fall back to LoggingEmailSender, no real email sent).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_STARTTLS=true
SMTP_FROM_ADDRESS=

# PayPal (optional — leave ClientId/Secret empty to disable billing/checkout, IPayPalClient won't
# register). BaseUrl defaults to the sandbox API; set it to https://api-m.paypal.com only once
# ClientId/Secret are a real Live app's credentials — mixing a Live BaseUrl with Sandbox
# credentials (or vice versa) fails PayPal's own OAuth, it does not silently misroute.
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# VIP annual-price override (optional — leave both empty to disable). If set, the account whose
# email matches BILLING_VIP_EMAIL is charged BILLING_VIP_ANNUAL_PRICE instead of Billing:AnnualPrice
# on checkout. See docs/features/billing.md "Prezzo VIP opzionale".
BILLING_VIP_EMAIL=
BILLING_VIP_ANNUAL_PRICE=
