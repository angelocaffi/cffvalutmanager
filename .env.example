# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# SQL Server 'sa' password. Must satisfy SQL Server's complexity policy (8+ chars, at least 3 of:
# uppercase, lowercase, digit, symbol).
MSSQL_SA_PASSWORD=

# Symmetric key used to sign/validate JWTs (Jwt:SigningKey). Generate a long random secret, e.g.:
#   openssl rand -base64 48
JWT_SIGNING_KEY=

# Public origin the browser loads the Web.Client app from (scheme+host, no trailing slash),
# e.g. https://vault.example.com. Used for both CORS (Api) and WebAuthn allowed origins.
WEB_PUBLIC_ORIGIN=

# WebAuthn relying party ID: the bare domain (no scheme/port) matching WEB_PUBLIC_ORIGIN,
# e.g. vault.example.com.
WEBAUTHN_RELYING_PARTY_ID=

# SMTP (optional — leave SMTP_HOST empty to fall back to LoggingEmailSender, no real email sent).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_STARTTLS=true
SMTP_FROM_ADDRESS=

# PayPal (optional — leave both empty to disable billing/checkout, IPayPalClient won't register).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
