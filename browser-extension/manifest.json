{
  "manifest_version": 3,
  "name": "CffVault",
  "short_name": "CffVault",
  "version": "0.1.0",
  "description": "Salva le credenziali nel tuo vault CffVault dopo un login riuscito.",
  "key": "",
  "permissions": ["offscreen"],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "CffVault"
  }
}
