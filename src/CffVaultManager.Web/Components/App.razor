<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="icon" type="image/svg+xml" href="@Assets["CffVaultmanager.svg"]" />
    <link rel="stylesheet" href="@Assets["lib/bootstrap/css/bootstrap.min.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["site-theme.css"]" />
    <link rel="stylesheet" href="@Assets["CffVaultManager.Web.styles.css"]" />
    <ImportMap />
    @* prerender: false on both outlets below — the vault's unlocked state (DEK, tokens) only ever
       exists in the WASM client's memory; there is nothing meaningful to render on the server, and
       every WASM-only service (SessionState, crypto, the Api HttpClient) would otherwise need a
       server-side counterpart just to satisfy a prerender pass. *@
    <HeadOutlet @rendermode="new InteractiveWebAssemblyRenderMode(prerender: false)" />
</head>

<body>
    <Routes @rendermode="new InteractiveWebAssemblyRenderMode(prerender: false)" />
    <script src="@Assets["lib/bootstrap/js/bootstrap.bundle.min.js"]"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>
