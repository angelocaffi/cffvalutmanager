@using System.Security.Cryptography
@using System.Text.Json
@using CffVaultManager.Crypto
@using CffVaultManager.Crypto.Abstractions
@using CffVaultManager.Web.Client.Models
@implements IDisposable
@inject IPasswordGeneratorService PasswordGenerator
@inject IPasswordStrengthService PasswordStrength
@inject IAeadCipherService AeadCipher
@inject ClipboardJsInterop Clipboard
@inject ShareLinkApiClient ShareLinkApi
@inject NavigationManager Navigation

<div class="mb-3">
    <label class="form-label">Titolo</label>
    <input class="form-control" @bind="Model.Title" @bind:event="oninput" disabled="@Disabled" required />
</div>

<div class="mb-3">
    <label class="form-label">Username / Email</label>
    <input class="form-control" @bind="Model.Username" @bind:event="oninput" disabled="@Disabled" />
</div>

<div class="mb-3">
    <label class="form-label">Password</label>
    <div class="input-group">
        <input type="@(_revealTimer.IsRevealed ? "text" : "password")" class="form-control"
               @bind="Model.Password" @bind:event="oninput" disabled="@Disabled" required />
        <button type="button" class="btn btn-outline-secondary" disabled="@Disabled" @onclick="ToggleRevealAsync">
            @(_revealTimer.IsRevealed ? "Nascondi" : "Mostra")
        </button>
        <button type="button" class="btn btn-outline-secondary" disabled="@(Disabled || string.IsNullOrEmpty(Model.Password))" @onclick="CopyPasswordAsync">
            Copia
        </button>
    </div>

    @if (!string.IsNullOrEmpty(Model.Password))
    {
        var strength = PasswordStrength.EstimateStrength(Model.Password);
        <div class="progress mt-1" style="height: 6px;">
            <div class="progress-bar @StrengthCssClass(strength.Level)" style="width: @(StrengthPercent(strength.Level))%"></div>
        </div>
        <div class="form-text">Forza: @StrengthLabel(strength.Level)</div>
    }

    @if (Model.PasswordHistory.Count > 0)
    {
        <div class="form-text">@Model.PasswordHistory.Count password precedenti salvate.</div>
    }
</div>

<div class="mb-3">
    <button type="button" class="btn btn-outline-info btn-sm" disabled="@Disabled" @onclick="() => _showGenerator = !_showGenerator">
        Genera password
    </button>
    <button type="button" class="btn btn-outline-secondary btn-sm ms-2"
            disabled="@(Disabled || ItemId is null || string.IsNullOrEmpty(Model.Password))"
            @onclick="() => _showShare = !_showShare">
        Condividi esternamente
    </button>
</div>

@if (_showShare)
{
    <div class="card card-body mb-3">
        <p class="text-body-secondary small mb-2">
            Genera un link temporaneo per condividere questa password con chi non ha un account.
            La chiave di decifratura viaggia solo nel link (mai inviata al server): chiunque abbia
            il link può leggere la password fino alla scadenza. Non incollarlo in chat che generano
            anteprime automatiche.
        </p>
        <div class="mb-2">
            <label class="form-label">Scadenza</label>
            <select class="form-select form-select-sm" style="max-width: 12rem;" @bind="_shareExpiresInMinutes">
                <option value="15">15 minuti</option>
                <option value="60">1 ora</option>
                <option value="1440">24 ore</option>
                <option value="10080">7 giorni</option>
            </select>
        </div>
        <div class="d-flex gap-2 align-items-center flex-wrap">
            <button type="button" class="btn btn-info btn-sm" disabled="@_shareBusy" @onclick="GenerateShareLinkAsync">
                @if (_shareBusy)
                {
                    <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                }
                Genera link
            </button>
        </div>

        @if (_shareLink is not null)
        {
            <div class="input-group mt-2" style="max-width: 32rem;">
                <input class="form-control form-control-sm" readonly value="@_shareLink" />
                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="CopyShareLinkAsync">Copia</button>
            </div>
        }

        @if (_shareError is not null)
        {
            <div class="alert alert-danger py-1 small mt-2" role="alert">@_shareError</div>
        }
    </div>
}

@if (_showGenerator)
{
    <div class="card card-body mb-3">
        <div class="mb-2">
            <label class="form-label">Lunghezza: @_genLength</label>
            <input type="range" class="form-range" min="8" max="64" @bind="_genLength" @bind:event="oninput" />
        </div>
        <div class="form-check">
            <input class="form-check-input" type="checkbox" @bind="_genUppercase" id="gen-upper" />
            <label class="form-check-label" for="gen-upper">Maiuscole</label>
        </div>
        <div class="form-check">
            <input class="form-check-input" type="checkbox" @bind="_genLowercase" id="gen-lower" />
            <label class="form-check-label" for="gen-lower">Minuscole</label>
        </div>
        <div class="form-check">
            <input class="form-check-input" type="checkbox" @bind="_genDigits" id="gen-digits" />
            <label class="form-check-label" for="gen-digits">Numeri</label>
        </div>
        <div class="form-check mb-2">
            <input class="form-check-input" type="checkbox" @bind="_genSymbols" id="gen-symbols" />
            <label class="form-check-label" for="gen-symbols">Simboli</label>
        </div>

        @if (_generatorError is not null)
        {
            <div class="alert alert-danger py-1 small" role="alert">@_generatorError</div>
        }

        <div class="d-flex gap-2 align-items-center flex-wrap">
            <button type="button" class="btn btn-outline-info btn-sm" @onclick="Regenerate">Rigenera</button>
            <button type="button" class="btn btn-info btn-sm" disabled="@string.IsNullOrEmpty(_generated)" @onclick="UseGenerated">
                Usa questa password
            </button>
            @if (_generated is not null)
            {
                <code>@_generated</code>
            }
        </div>
    </div>
}

<div class="mb-3">
    <label class="form-label">URL</label>
    <input class="form-control" @bind="Model.Url" @bind:event="oninput" disabled="@Disabled" />
</div>

<div class="mb-3">
    <label class="form-label">Note</label>
    <textarea class="form-control" rows="3" @bind="Model.Notes" @bind:event="oninput" disabled="@Disabled"></textarea>
</div>

@code {
    [Parameter, EditorRequired]
    public PasswordFormModel Model { get; set; } = null!;

    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>Invoked whenever the password is actually revealed or copied — the parent records the server-side reveal audit event.</summary>
    [Parameter]
    public EventCallback OnRevealPassword { get; set; }

    /// <summary>The vault this item belongs to — needed to call the external share-link endpoint.</summary>
    [Parameter]
    public Guid VaultId { get; set; }

    /// <summary>Null for a not-yet-saved item: external sharing requires an existing item id.</summary>
    [Parameter]
    public Guid? ItemId { get; set; }

    private readonly RevealTimer _revealTimer;
    private bool _showGenerator;
    private int _genLength = 16;
    private bool _genUppercase = true;
    private bool _genLowercase = true;
    private bool _genDigits = true;
    private bool _genSymbols = true;
    private string? _generated;
    private string? _generatorError;

    private bool _showShare;
    private bool _shareBusy;
    private int _shareExpiresInMinutes = 60;
    private string? _shareLink;
    private string? _shareError;

    public PasswordFields() => _revealTimer = new RevealTimer(() => InvokeAsync(StateHasChanged));

    private async Task ToggleRevealAsync()
    {
        if (_revealTimer.IsRevealed)
        {
            _revealTimer.Hide();
            return;
        }

        await OnRevealPassword.InvokeAsync();
        _revealTimer.Reveal(TimeSpan.FromSeconds(20));
    }

    private async Task CopyPasswordAsync()
    {
        await OnRevealPassword.InvokeAsync();
        await Clipboard.CopyWithAutoClearAsync(Model.Password);
    }

    private async Task GenerateShareLinkAsync()
    {
        if (ItemId is not { } itemId || string.IsNullOrEmpty(Model.Password))
        {
            return;
        }

        _shareError = null;
        _shareLink = null;
        _shareBusy = true;
        try
        {
            byte[] shareKey = RandomNumberGenerator.GetBytes(CryptoConstants.KeyLengthBytes);
            var snapshot = new SharedPasswordSnapshot(Model.Title, Model.Username, Model.Password, Model.Url);
            byte[] plaintext = JsonSerializer.SerializeToUtf8Bytes(snapshot);
            byte[] encryptedPayload = AeadCipher.Encrypt(plaintext, shareKey).ToBytes();

            var created = await ShareLinkApi.CreateAsync(VaultId, itemId, encryptedPayload, _shareExpiresInMinutes);
            if (created is null)
            {
                _shareError = "Impossibile generare il link di condivisione.";
                return;
            }

            string keyBase64Url = Convert.ToBase64String(shareKey).Replace('+', '-').Replace('/', '_').TrimEnd('=');
            _shareLink = $"{Navigation.BaseUri}share/{created.Token}#key={keyBase64Url}";
        }
        catch (HttpRequestException)
        {
            _shareError = "Impossibile generare il link di condivisione.";
        }
        finally
        {
            _shareBusy = false;
        }
    }

    private async Task CopyShareLinkAsync()
    {
        if (_shareLink is not null)
        {
            await Clipboard.CopyWithAutoClearAsync(_shareLink);
        }
    }

    private void Regenerate()
    {
        _generatorError = null;
        try
        {
            _generated = PasswordGenerator.GeneratePassword(new PasswordGeneratorOptions(
                _genLength, _genUppercase, _genLowercase, _genDigits, _genSymbols));
        }
        catch (ArgumentException ex)
        {
            _generatorError = ex.Message;
            _generated = null;
        }
    }

    private void UseGenerated()
    {
        if (_generated is not null)
        {
            Model.Password = _generated;
            _showGenerator = false;
        }
    }

    private static string StrengthLabel(PasswordStrengthLevel level) => level switch
    {
        PasswordStrengthLevel.VeryWeak => "Molto debole",
        PasswordStrengthLevel.Weak => "Debole",
        PasswordStrengthLevel.Fair => "Sufficiente",
        PasswordStrengthLevel.Strong => "Forte",
        PasswordStrengthLevel.VeryStrong => "Molto forte",
        _ => level.ToString(),
    };

    private static string StrengthCssClass(PasswordStrengthLevel level) => level switch
    {
        PasswordStrengthLevel.VeryWeak => "bg-danger",
        PasswordStrengthLevel.Weak => "bg-warning",
        PasswordStrengthLevel.Fair => "bg-warning",
        PasswordStrengthLevel.Strong => "bg-info",
        PasswordStrengthLevel.VeryStrong => "bg-success",
        _ => "bg-secondary",
    };

    private static int StrengthPercent(PasswordStrengthLevel level) => level switch
    {
        PasswordStrengthLevel.VeryWeak => 20,
        PasswordStrengthLevel.Weak => 40,
        PasswordStrengthLevel.Fair => 60,
        PasswordStrengthLevel.Strong => 80,
        PasswordStrengthLevel.VeryStrong => 100,
        _ => 0,
    };

    public void Dispose() => _revealTimer.Dispose();
}
