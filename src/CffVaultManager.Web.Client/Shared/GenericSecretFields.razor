@using CffVaultManager.Web.Client.Models

<div class="mb-3">
    <label class="form-label">Titolo</label>
    <input class="form-control" @bind="Model.Title" @bind:event="oninput" disabled="@Disabled" required />
</div>

<div class="mb-3">
    <label class="form-label">Campi personalizzati</label>
    <p class="text-body-secondary small">
        Chiave/valore libero — per API key, chiavi SSH, PIN o qualunque altro dato non previsto dagli altri tipi.
    </p>
    @for (int i = 0; i < Model.Fields.Count; i++)
    {
        var field = Model.Fields[i];
        <div class="input-group mb-2">
            <input class="form-control" placeholder="Nome campo" @bind="field.Key" @bind:event="oninput" disabled="@Disabled" style="max-width: 12rem;" />
            <input class="form-control" placeholder="Valore" @bind="field.Value" @bind:event="oninput" disabled="@Disabled" />
            @if (Model.Fields.Count > 1)
            {
                <button type="button" class="btn btn-outline-danger" disabled="@Disabled" @onclick="() => RemoveField(field)">
                    Rimuovi
                </button>
            }
        </div>
    }
    <button type="button" class="btn btn-outline-info btn-sm" disabled="@Disabled" @onclick="AddField">Aggiungi campo</button>
</div>

<div class="mb-3">
    <label class="form-label">Note</label>
    <textarea class="form-control" rows="3" @bind="Model.Notes" @bind:event="oninput" disabled="@Disabled"></textarea>
</div>

@code {
    [Parameter, EditorRequired]
    public GenericSecretFormModel Model { get; set; } = null!;

    [Parameter]
    public bool Disabled { get; set; }

    private void AddField() => Model.Fields.Add(new KeyValueFieldModel());

    private void RemoveField(KeyValueFieldModel field) => Model.Fields.Remove(field);
}
