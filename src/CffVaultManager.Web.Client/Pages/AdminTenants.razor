@page "/admin/tenants"
@attribute [Authorize(Roles = "SuperAdmin")]
@using CffVaultManager.Web.Client.Services
@inject AdminApiClient AdminApi

<PageTitle>Amministrazione tenant</PageTitle>

<h1 class="h3 mb-1">Amministrazione tenant</h1>
<p class="text-body-secondary small mb-4">
    Solo metadati aggregati sui tenant della piattaforma: nessun ruolo, nemmeno SuperAdmin, può
    vedere il contenuto dei vault.
</p>

@if (_errorMessage is not null)
{
    <div class="alert alert-danger py-2" role="alert">@_errorMessage</div>
}

@if (_tenants is null)
{
    <div class="d-flex align-items-center gap-2 text-body-secondary">
        <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
        <span>Caricamento…</span>
    </div>
}
else if (_tenants.Count == 0)
{
    <EmptyState Message="Nessun tenant registrato." />
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Nome</th>
                    <th>Slug</th>
                    <th>Stato</th>
                    <th>Piano</th>
                    <th>Utenti</th>
                    <th>Vault</th>
                    <th>Creato il</th>
                    <th class="text-end">Azioni</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var tenant in _tenants)
                {
                    <tr>
                        <td class="fw-semibold">@tenant.Name</td>
                        <td class="font-monospace small">@tenant.Slug</td>
                        <td><span class="badge @StatusBadgeClass(tenant.Status)">@StatusLabel(tenant.Status)</span></td>
                        <td>@(tenant.PlanName ?? "—")</td>
                        <td>@tenant.UserCount</td>
                        <td>@tenant.VaultCount</td>
                        <td class="text-nowrap">@tenant.CreatedAt.ToLocalTime().ToString("g")</td>
                        <td class="text-end">
                            <div class="d-flex justify-content-end gap-2">
                                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="() => ToggleDetailsAsync(tenant.Id)">
                                    @(_expandedTenantId == tenant.Id ? "Nascondi" : "Dettagli")
                                </button>
                                @if (tenant.Status == TenantStatuses.Suspended)
                                {
                                    <button type="button" class="btn btn-outline-success btn-sm" disabled="@_busy" @onclick="() => RequestConfirm(tenant.Id, reactivate: true)">
                                        Riattiva
                                    </button>
                                }
                                else
                                {
                                    <button type="button" class="btn btn-outline-danger btn-sm" disabled="@_busy" @onclick="() => RequestConfirm(tenant.Id, reactivate: false)">
                                        Sospendi
                                    </button>
                                }
                            </div>
                        </td>
                    </tr>
                    @if (_confirmingTenantId == tenant.Id)
                    {
                        <tr>
                            <td colspan="8" class="py-2">
                                <div class="alert @(_confirmReactivate ? "alert-success" : "alert-warning") py-2 mb-0 d-flex flex-wrap justify-content-between align-items-center gap-2">
                                    <span>
                                        @(_confirmReactivate
                                            ? $"Riattivare l'accesso per \"{tenant.Name}\"? I suoi utenti potranno tornare ad accedere."
                                            : $"Sospendere \"{tenant.Name}\"? Nessun utente di questo tenant potrà più accedere (login e refresh bloccati) finché non lo riattivi.")
                                    </span>
                                    <div class="d-flex gap-2">
                                        <button type="button" class="btn @(_confirmReactivate ? "btn-success" : "btn-danger") btn-sm" disabled="@_busy" @onclick="() => ConfirmAsync(tenant.Id)">
                                            @if (_busy)
                                            {
                                                <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                                            }
                                            Conferma
                                        </button>
                                        <button type="button" class="btn btn-outline-secondary btn-sm" disabled="@_busy" @onclick="CancelConfirm">Annulla</button>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                    @if (_expandedTenantId == tenant.Id)
                    {
                        <tr>
                            <td colspan="8" class="py-3">
                                @if (_usageLoading)
                                {
                                    <div class="d-flex align-items-center gap-2 text-body-secondary">
                                        <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                                        <span>Caricamento utilizzo…</span>
                                    </div>
                                }
                                else if (_usage is null)
                                {
                                    <span class="text-body-secondary">Impossibile caricare i dati di utilizzo per questo tenant.</span>
                                }
                                else
                                {
                                    <div class="row row-cols-1 row-cols-sm-3 g-3" style="max-width: 40rem;">
                                        <div class="col">
                                            <div class="text-body-secondary small">Voci nei vault</div>
                                            <div class="fs-5 fw-semibold">@_usage.VaultItemCount</div>
                                        </div>
                                        <div class="col">
                                            <div class="text-body-secondary small">Ultimo accesso utente</div>
                                            <div class="fs-5 fw-semibold">
                                                @(_usage.LastUserLoginAt is { } lastLogin ? lastLogin.ToLocalTime().ToString("g") : "Mai")
                                            </div>
                                        </div>
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
}

@code {
    private IReadOnlyList<TenantSummaryResponse>? _tenants;
    private string? _errorMessage;
    private bool _busy;

    private Guid? _expandedTenantId;
    private TenantUsageResponse? _usage;
    private bool _usageLoading;

    private Guid? _confirmingTenantId;
    private bool _confirmReactivate;

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        _errorMessage = null;
        try
        {
            _tenants = await AdminApi.ListTenantsAsync();
        }
        catch (Exception)
        {
            _tenants = [];
            _errorMessage = "Impossibile caricare l'elenco dei tenant.";
        }
    }

    private async Task ToggleDetailsAsync(Guid tenantId)
    {
        if (_expandedTenantId == tenantId)
        {
            _expandedTenantId = null;
            _usage = null;
            return;
        }

        _expandedTenantId = tenantId;
        _usage = null;
        _usageLoading = true;
        try
        {
            _usage = await AdminApi.GetTenantUsageAsync(tenantId);
        }
        finally
        {
            _usageLoading = false;
        }
    }

    private void RequestConfirm(Guid tenantId, bool reactivate)
    {
        _errorMessage = null;
        _confirmingTenantId = tenantId;
        _confirmReactivate = reactivate;
    }

    private void CancelConfirm() => _confirmingTenantId = null;

    private async Task ConfirmAsync(Guid tenantId)
    {
        _busy = true;
        try
        {
            bool success = _confirmReactivate
                ? await AdminApi.ReactivateTenantAsync(tenantId)
                : await AdminApi.SuspendTenantAsync(tenantId);

            if (!success)
            {
                _errorMessage = _confirmReactivate ? "Impossibile riattivare il tenant." : "Impossibile sospendere il tenant.";
                return;
            }

            _confirmingTenantId = null;
            await ReloadAsync();
            if (_expandedTenantId == tenantId)
            {
                _usage = await AdminApi.GetTenantUsageAsync(tenantId);
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private static string StatusBadgeClass(string status) => status switch
    {
        TenantStatuses.Active => "text-bg-success",
        TenantStatuses.Suspended => "text-bg-danger",
        TenantStatuses.PendingSetup => "text-bg-warning",
        _ => "text-bg-secondary",
    };

    private static string StatusLabel(string status) => status switch
    {
        TenantStatuses.Active => "Attivo",
        TenantStatuses.Suspended => "Sospeso",
        TenantStatuses.PendingSetup => "In configurazione",
        _ => status,
    };
}
