@page "/recovery"
@using System.Security.Cryptography
@using System.Text.Json
@using CffVaultManager.Crypto
@using CffVaultManager.Crypto.Abstractions
@implements IDisposable
@inject AuthApiClient AuthApi
@inject IKeyDerivationService KeyDerivation
@inject IAuthHashService AuthHashService
@inject IDekService DekService
@inject IRecoveryKeyService RecoveryKeyService
@inject NavigationManager Navigation
@inject WebAuthnJsInterop WebAuthn

<PageTitle>Recupera l'accesso</PageTitle>

<div class="auth-shell">
    <div class="auth-panel">
        <div class="auth-brand-panel d-none d-lg-flex">
            <div class="auth-brand-panel-content">
                <BrandMark IconClass="auth-brand-icon mb-2 d-block mx-auto" TextClass="auth-brand-text d-block" />
                <p class="auth-brand-tagline">Recupera l'accesso senza che la tua master password lasci mai il browser.</p>
            </div>
        </div>
        <div class="auth-form-panel">
            <div class="auth-form-panel-inner">
                <div class="d-flex align-items-center justify-content-center gap-2 mb-3 d-lg-none">
                    <BrandMark IconClass="login-logo" TextClass="fs-5" />
                </div>
                <h1 class="h4 mb-4 text-primary text-center">Recupera l'accesso</h1>

            @if (_stage == Stage.Done)
            {
                <p class="text-success">Master password reimpostata. Effettua di nuovo il login.</p>
                <a class="btn btn-info w-100" href="/login">Vai al login</a>
            }
            else if (_stage == Stage.EmailAndKey)
            {
                <p class="text-body-secondary small">
                    Inserisci l'email del tuo account e la Recovery Key salvata quando hai generato il
                    kit di recupero dalle impostazioni di sicurezza.
                </p>

                <form @onsubmit="HandleEmailAndKeySubmitAsync" @onsubmit:preventDefault="true">
                    <div class="mb-3">
                        <label for="recovery-email" class="form-label">Email</label>
                        <input id="recovery-email" type="email" class="form-control" @bind="_email" @bind:event="oninput"
                               required disabled="@_busy" autocomplete="username" />
                    </div>
                    <div class="mb-3">
                        <label for="recovery-key" class="form-label">Recovery Key</label>
                        <input id="recovery-key" type="text" class="form-control font-monospace" @bind="_recoveryKeyInput" @bind:event="oninput"
                               required disabled="@_busy" placeholder="XXXXXXXX-XXXXXXXX-XXXXXXXX-XXXXXXXX-XXXXXXXX-XXXXXXXX-XXXXXXXX-XXXXXXXX" />
                    </div>

                    @if (_errorMessage is not null)
                    {
                        <div class="alert alert-danger py-2" role="alert">@_errorMessage</div>
                    }

                    <button type="submit" class="btn btn-info w-100" disabled="@_busy">
                        @if (_busy)
                        {
                            <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                        }
                        @(_busy ? "Verifica in corso…" : "Continua")
                    </button>
                </form>

                <p class="text-center small text-body-secondary mt-3 mb-0">
                    <a href="/login">Torna al login</a>
                </p>
            }
            else if (_stage == Stage.Mfa && _selectedFactor is null)
            {
                <p class="text-body-secondary small">Il tuo account ha un secondo fattore attivo: scegli come completare il recupero.</p>

                @if (_errorMessage is not null)
                {
                    <div class="alert alert-danger py-2" role="alert">@_errorMessage</div>
                }

                <div class="d-grid gap-2">
                    @if (_availableFactors.Contains("WebAuthn"))
                    {
                        <button type="button" class="btn btn-outline-info" @onclick='() => SelectFactorAsync("WebAuthn")'>
                            Chiave di sicurezza o impronta/volto
                        </button>
                    }
                    @if (_availableFactors.Contains("Totp"))
                    {
                        <button type="button" class="btn btn-outline-info" @onclick='() => SelectFactorAsync("Totp")'>
                            App authenticator (TOTP)
                        </button>
                    }
                    @if (_availableFactors.Contains("EmailOtp"))
                    {
                        <button type="button" class="btn btn-outline-info" @onclick='() => SelectFactorAsync("EmailOtp")'>
                            Codice via email <span class="badge text-bg-secondary">meno sicuro</span>
                        </button>
                    }
                </div>
            }
            else if (_stage == Stage.Mfa && _selectedFactor == "WebAuthn")
            {
                <p class="text-body-secondary small">
                    @(_busy
                        ? "Segui le istruzioni del browser per verificare la tua identità (impronta, volto o chiave di sicurezza)."
                        : "Verifica non riuscita o annullata.")
                </p>

                @if (_errorMessage is not null)
                {
                    <div class="alert alert-danger py-2" role="alert">@_errorMessage</div>
                }

                <button type="button" class="btn btn-info w-100 mb-2" disabled="@_busy" @onclick="StartWebAuthnAsync">
                    @if (_busy)
                    {
                        <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                    }
                    @(_busy ? "Verifica in corso…" : "Riprova")
                </button>

                @if (_availableFactors.Count > 1)
                {
                    <button type="button" class="btn btn-link btn-sm w-100" disabled="@_busy" @onclick="ResetFactorSelection">
                        Usa un altro metodo
                    </button>
                }
            }
            else if (_stage == Stage.Mfa)
            {
                <form @onsubmit="HandleMfaSubmitAsync" @onsubmit:preventDefault="true">
                    @if (_selectedFactor == "EmailOtp")
                    {
                        <p class="text-body-secondary small">
                            @if (_codeExpirySeconds is null)
                            {
                                <span>Invio del codice in corso…</span>
                            }
                            else if (_codeExpirySeconds > 0)
                            {
                                <span>Ti abbiamo inviato un codice via email. Inseriscilo qui sotto. Scade tra @FormatCountdown(_codeExpirySeconds.Value).</span>
                            }
                            else
                            {
                                <span>Il codice è scaduto: inviane uno nuovo.</span>
                            }
                        </p>
                    }
                    else
                    {
                        <p class="text-body-secondary small">Inserisci il codice a 6 cifre della tua app di autenticazione.</p>
                    }

                    <div class="mb-3">
                        <label for="recovery-mfa-code" class="form-label">Codice</label>
                        <input id="recovery-mfa-code" type="text" class="form-control" inputmode="numeric" autocomplete="one-time-code" maxlength="6"
                               @bind="_mfaCode" @bind:event="oninput" required disabled="@_busy" />
                    </div>

                    @if (_errorMessage is not null)
                    {
                        <div class="alert alert-danger py-2" role="alert">@_errorMessage</div>
                    }

                    <button type="submit" class="btn btn-info w-100 mb-2" disabled="@_busy">
                        @if (_busy)
                        {
                            <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                        }
                        @(_busy ? "Verifica in corso…" : "Verifica")
                    </button>

                    @if (_selectedFactor == "EmailOtp")
                    {
                        <button type="button" class="btn btn-link btn-sm w-100" disabled="@(_busy || _resendCooldownSeconds > 0)"
                                @onclick="() => SendEmailOtpAsync()">
                            @(_resendCooldownSeconds > 0 ? $"Reinvia tra {_resendCooldownSeconds}s" : "Invia di nuovo")
                        </button>
                    }

                    @if (_availableFactors.Count > 1)
                    {
                        <button type="button" class="btn btn-link btn-sm w-100" disabled="@_busy" @onclick="ResetFactorSelection">
                            Usa un altro metodo
                        </button>
                    }
                </form>
            }
            else if (_stage == Stage.NewPassword)
            {
                <p class="text-body-secondary small">Scegli una nuova master password per il tuo account.</p>

                <form @onsubmit="HandleNewPasswordSubmitAsync" @onsubmit:preventDefault="true">
                    <div class="mb-3">
                        <label for="recovery-new-password" class="form-label">Nuova master password</label>
                        <input id="recovery-new-password" type="password" class="form-control" @bind="_newMasterPassword" @bind:event="oninput"
                               required disabled="@_busy" minlength="12" autocomplete="new-password" />
                        <div class="form-text">Almeno 12 caratteri. Non lascia mai il browser.</div>
                    </div>
                    <div class="mb-3">
                        <label for="recovery-new-password-confirm" class="form-label">Conferma nuova master password</label>
                        <input id="recovery-new-password-confirm" type="password" class="form-control" @bind="_newMasterPasswordConfirm" @bind:event="oninput"
                               required disabled="@_busy" autocomplete="new-password" />
                    </div>

                    @if (_errorMessage is not null)
                    {
                        <div class="alert alert-danger py-2" role="alert">@_errorMessage</div>
                    }

                    <button type="submit" class="btn btn-info w-100" disabled="@_busy">
                        @if (_busy)
                        {
                            <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                        }
                        @(_busy ? "Salvataggio in corso…" : "Imposta nuova master password")
                    </button>
                </form>
            }
            </div>
        </div>
    </div>
</div>

@code {
    private enum Stage { EmailAndKey, Mfa, NewPassword, Done }

    private Stage _stage = Stage.EmailAndKey;

    private string _email = string.Empty;
    private string _recoveryKeyInput = string.Empty;
    private string _newMasterPassword = string.Empty;
    private string _newMasterPasswordConfirm = string.Empty;
    private string _mfaCode = string.Empty;
    private string? _errorMessage;
    private bool _busy;

    private IReadOnlyList<string> _availableFactors = Array.Empty<string>();
    private string? _selectedFactor;
    private int _resendCooldownSeconds;
    private int? _codeExpirySeconds;
    private Timer? _countdownTimer;

    private const int ResendCooldownSeconds = 60;
    private const int CodeExpirySeconds = 600;

    // Held only for the duration of this flow, never persisted, zeroed on completion/Dispose —
    // same discipline as Login.razor's _pendingKek.
    private byte[]? _dek;
    private string? _pendingChallengeToken;
    private string? _recoveryToken;

    private async Task HandleEmailAndKeySubmitAsync()
    {
        _errorMessage = null;
        _busy = true;
        try
        {
            if (!RecoveryKeyFormatter.TryParse(_recoveryKeyInput, out byte[] recoveryKeyBytes))
            {
                _errorMessage = "Formato della Recovery Key non valido.";
                return;
            }

            byte[] blobBytes = await AuthApi.StartRecoveryAsync(_email);

            byte[] dek;
            byte[] recoveryAuthHash;
            try
            {
                var blob = EncryptedBlob.FromBytes(blobBytes);
                dek = DekService.DecryptDek(blob, recoveryKeyBytes);
                recoveryAuthHash = RecoveryKeyService.DeriveRecoveryAuthHash(recoveryKeyBytes);
            }
            catch (Exception)
            {
                // Never a further server call here: the server itself cannot distinguish "email
                // sconosciuta" from "chiave sbagliata" (see docs/security-model.md#recovery-kit),
                // and neither should this error message.
                _errorMessage = "Email o Recovery Key non validi.";
                return;
            }
            finally
            {
                CryptographicOperations.ZeroMemory(recoveryKeyBytes);
            }

            var result = await AuthApi.VerifyRecoveryAsync(_email, recoveryAuthHash);

            if (result.RequiresMfa && result.MfaChallengeToken is not null)
            {
                _dek = dek;
                _pendingChallengeToken = result.MfaChallengeToken;
                _availableFactors = result.AvailableMfaFactors ?? Array.Empty<string>();
                _stage = Stage.Mfa;

                if (_availableFactors.Count == 1)
                {
                    await SelectFactorAsync(_availableFactors[0]);
                }

                return;
            }

            if (!result.Success || result.RecoveryToken is null)
            {
                _errorMessage = "Email o Recovery Key non validi.";
                return;
            }

            _dek = dek;
            _recoveryToken = result.RecoveryToken;
            _stage = Stage.NewPassword;
        }
        catch (JsonException)
        {
            // RecoveryStartResponse has no Success flag — a non-2xx response (most commonly 429
            // from AuthRateLimiting) makes AuthApiClient throw instead of returning a failure
            // shape, same crash class already fixed on the login flow.
            _errorMessage = "Troppi tentativi o errore del server. Riprova tra qualche minuto.";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SelectFactorAsync(string factor)
    {
        _errorMessage = null;
        _mfaCode = string.Empty;
        _selectedFactor = factor;

        if (factor == "EmailOtp")
        {
            await SendEmailOtpAsync();
        }
        else if (factor == "WebAuthn")
        {
            await StartWebAuthnAsync();
        }
    }

    private async Task StartWebAuthnAsync()
    {
        if (_pendingChallengeToken is null)
        {
            return;
        }

        _errorMessage = null;
        _busy = true;
        try
        {
            string? optionsJson = await AuthApi.BeginRecoveryWebAuthnAssertionAsync(_pendingChallengeToken);
            if (optionsJson is null)
            {
                _errorMessage = "Impossibile avviare la verifica. Riprova dall'inizio.";
                return;
            }

            string? assertionResponseJson = await WebAuthn.AuthenticateAsync(optionsJson);
            if (assertionResponseJson is null)
            {
                _errorMessage = "Verifica annullata o non riuscita.";
                return;
            }

            var result = await AuthApi.CompleteRecoveryWebAuthnAssertionAsync(_pendingChallengeToken, assertionResponseJson);
            if (!result.Success || result.RecoveryToken is null)
            {
                _errorMessage = "Verifica non riuscita.";
                return;
            }

            _recoveryToken = result.RecoveryToken;
            _stage = Stage.NewPassword;
        }
        finally
        {
            _busy = false;
        }
    }

    private void ResetFactorSelection()
    {
        StopCountdown();
        _selectedFactor = null;
        _mfaCode = string.Empty;
        _errorMessage = null;
        _resendCooldownSeconds = 0;
        _codeExpirySeconds = null;
    }

    private async Task SendEmailOtpAsync()
    {
        if (_pendingChallengeToken is null)
        {
            return;
        }

        _busy = true;
        try
        {
            bool sent = await AuthApi.SendRecoveryMfaEmailOtpAsync(_pendingChallengeToken);
            if (!sent)
            {
                _errorMessage = "Impossibile inviare il codice. Riprova dall'inizio.";
                return;
            }

            _resendCooldownSeconds = ResendCooldownSeconds;
            _codeExpirySeconds = CodeExpirySeconds;
            StartCountdown();
        }
        finally
        {
            _busy = false;
        }
    }

    private void StartCountdown()
    {
        _countdownTimer ??= new Timer(_ => InvokeAsync(TickCountdown), null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
    }

    private void StopCountdown()
    {
        _countdownTimer?.Dispose();
        _countdownTimer = null;
    }

    private void TickCountdown()
    {
        if (_resendCooldownSeconds > 0)
        {
            _resendCooldownSeconds--;
        }

        if (_codeExpirySeconds is > 0)
        {
            _codeExpirySeconds--;
        }

        if (_resendCooldownSeconds == 0 && _codeExpirySeconds == 0)
        {
            StopCountdown();
        }

        StateHasChanged();
    }

    private static string FormatCountdown(int totalSeconds) =>
        $"{totalSeconds / 60}:{totalSeconds % 60:D2}";

    private async Task HandleMfaSubmitAsync()
    {
        if (_pendingChallengeToken is null || _selectedFactor is null)
        {
            _stage = Stage.EmailAndKey;
            return;
        }

        _errorMessage = null;
        _busy = true;
        try
        {
            var result = await AuthApi.VerifyRecoveryMfaAsync(_pendingChallengeToken, _mfaCode, _selectedFactor);

            if (!result.Success || result.RecoveryToken is null)
            {
                _errorMessage = "Codice non valido.";
                return;
            }

            _recoveryToken = result.RecoveryToken;
            _stage = Stage.NewPassword;
        }
        finally
        {
            _mfaCode = string.Empty;
            _busy = false;
        }
    }

    private async Task HandleNewPasswordSubmitAsync()
    {
        _errorMessage = null;

        if (_newMasterPassword != _newMasterPasswordConfirm)
        {
            _errorMessage = "Le due master password non coincidono.";
            return;
        }

        if (_newMasterPassword.Length < 12)
        {
            _errorMessage = "La master password deve avere almeno 12 caratteri.";
            return;
        }

        if (_dek is null || _recoveryToken is null)
        {
            // Lost the in-memory DEK/token (e.g. a page reload mid-flow) — nothing to re-wrap with,
            // start over rather than get stuck on a form that can't succeed.
            _stage = Stage.EmailAndKey;
            return;
        }

        _busy = true;
        try
        {
            byte[] salt = RandomNumberGenerator.GetBytes(16);
            var kdfParams = Argon2Parameters.Default;

            using var kek = await KeyDerivation.DeriveKekAsync(_newMasterPassword, salt, kdfParams);
            byte[] authHash = AuthHashService.DeriveAuthHash(kek, _newMasterPassword);

            // Re-wraps the DEK unwrapped via the Recovery Key back in step 1 — never generates a
            // new one, so existing vault items stay decryptable unchanged.
            byte[] newEncryptedDek = DekService.EncryptDek(_dek, kek.Key).ToBytes();

            var (success, error) = await AuthApi.CompleteRecoveryAsync(
                _recoveryToken, authHash, newEncryptedDek, salt, kdfParams.MemoryKb, kdfParams.Iterations, kdfParams.Version);

            if (!success)
            {
                _errorMessage = error;
                return;
            }

            ClearSensitiveState();
            _stage = Stage.Done;
        }
        finally
        {
            _newMasterPassword = string.Empty;
            _newMasterPasswordConfirm = string.Empty;
            _busy = false;
        }
    }

    private void ClearSensitiveState()
    {
        if (_dek is not null)
        {
            CryptographicOperations.ZeroMemory(_dek);
            _dek = null;
        }
    }

    public void Dispose()
    {
        StopCountdown();
        ClearSensitiveState();
    }
}
