@page "/vault/{VaultId:guid}/items/new/{Type}"
@page "/vault/{VaultId:guid}/items/{ItemId:guid}"
@attribute [Authorize]
@using System.Security.Cryptography
@using System.Text.Json
@using CffVaultManager.Crypto
@using CffVaultManager.Crypto.Abstractions
@using CffVaultManager.Web.Client.Models
@using CffVaultManager.Web.Client.Shared
@inject VaultApiClient VaultApi
@inject SessionState Session
@inject IAeadCipherService AeadCipher
@inject NavigationManager Navigation
@inject ItemSharingApiClient ItemSharingApi
@inject ItemKeyResolver ItemKeyResolver

<PageTitle>@(_isNew ? "Nuova voce" : "Modifica voce")</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">@(_isNew ? "Nuova voce" : "Modifica voce")</h1>
    <a class="btn btn-outline-secondary" href="@($"/vault/{VaultId}")">Annulla</a>
</div>

@if (_loading)
{
    <div class="d-flex align-items-center gap-2 text-body-secondary">
        <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
        <span>Caricamento…</span>
    </div>
}
else
{
    <form @onsubmit="SaveAsync" @onsubmit:preventDefault="true" style="max-width: 32rem;">
        @if (_errorMessage is not null)
        {
            <div class="alert alert-danger py-2" role="alert">@_errorMessage</div>
        }

        @if (_effectiveType == VaultItemTypes.Password)
        {
            <PasswordFields Model="_passwordModel" Disabled="_busy" OnRevealPassword="RecordRevealAsync" VaultId="VaultId" ItemId="ItemId" />
        }
        else if (_effectiveType == VaultItemTypes.CreditCard)
        {
            <CreditCardFields Model="_creditCardModel" Disabled="_busy" OnRevealSensitiveField="RecordRevealAsync" />
        }
        else if (_effectiveType == VaultItemTypes.CryptoWallet)
        {
            <CryptoWalletFields Model="_cryptoWalletModel" Disabled="_busy" OnRevealSensitiveField="RecordRevealAsync" />
        }
        else if (_effectiveType == VaultItemTypes.SecureNote)
        {
            <SecureNoteFields Model="_secureNoteModel" Disabled="_busy" />
        }
        else if (_effectiveType == VaultItemTypes.GenericSecret)
        {
            <GenericSecretFields Model="_genericSecretModel" Disabled="_busy" />
        }
        else
        {
            <div class="alert alert-warning" role="alert">Tipo di voce non supportato: @_effectiveType.</div>
        }

        <div class="form-check mb-3">
            <input class="form-check-input" type="checkbox" @bind="_isFavorite" id="item-favorite" disabled="@_busy" />
            <label class="form-check-label" for="item-favorite">Preferito</label>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-info" disabled="@_busy">
                @if (_busy)
                {
                    <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                }
                @(_busy ? "Salvataggio…" : "Salva")
            </button>
            @if (!_isNew)
            {
                <button type="button" class="btn btn-outline-danger" disabled="@_busy" @onclick="DeleteAsync">Elimina</button>
            }
        </div>
    </form>

    @if (!_isNew)
    {
        <div class="card mt-4" style="max-width: 32rem;">
            <div class="card-body">
                <h2 class="h5">Condivisione</h2>

                @if (_mySharedAccess is null)
                {
                    <p class="text-body-secondary small">Questa voce non è ancora condivisa con nessuno.</p>
                }
                else
                {
                    <p class="text-body-secondary small">Il tuo ruolo su questa voce: <strong>@PermissionLabel(_mySharedAccess.Permission)</strong>.</p>

                    @if (_members.Count > 0)
                    {
                        <ul class="list-group mb-3">
                            @foreach (var m in _members)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    <span class="small font-monospace">@m.UserId @(m.UserId == _ownerId ? "(tu)" : "")</span>
                                    <span class="d-flex align-items-center gap-2">
                                        <span class="badge bg-secondary">@PermissionLabel(m.Permission)</span>
                                        @if (_mySharedAccess.Permission == "Owner" && m.UserId != _ownerId)
                                        {
                                            <button type="button" class="btn btn-outline-danger btn-sm" disabled="@_shareBusy" @onclick="() => RevokeMemberAsync(m.UserId)">Revoca</button>
                                        }
                                    </span>
                                </li>
                            }
                        </ul>
                    }
                }

                @if (_mySharedAccess is null || _mySharedAccess.Permission == "Owner")
                {
                    <div class="mb-2">
                        <label class="form-label">Email destinatario</label>
                        <input class="form-control" @bind="_shareEmail" disabled="@_shareBusy" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label">Permesso</label>
                        <select class="form-select" style="max-width: 12rem;" @bind="_sharePermission">
                            <option value="Viewer">Sola lettura</option>
                            <option value="Editor">Modifica</option>
                        </select>
                    </div>
                    <button type="button" class="btn btn-info btn-sm" disabled="@_shareBusy" @onclick="ShareOrAddMemberAsync">
                        @if (_shareBusy)
                        {
                            <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                        }
                        Condividi con un utente
                    </button>
                }

                @if (_shareError is not null)
                {
                    <div class="alert alert-danger py-2 mt-2" role="alert">@_shareError</div>
                }
                @if (_shareSuccess is not null)
                {
                    <div class="alert alert-success py-2 mt-2" role="alert">@_shareSuccess</div>
                }
            </div>
        </div>
    }
}

@code {
    [Parameter]
    public Guid VaultId { get; set; }

    [Parameter]
    public string? Type { get; set; }

    [Parameter]
    public Guid? ItemId { get; set; }

    private bool _isNew;
    private string _effectiveType = string.Empty;
    private Guid? _folderId;
    private bool _loading = true;
    private bool _busy;
    private bool _isFavorite;
    private string? _errorMessage;

    private PasswordFormModel _passwordModel = new();
    private CreditCardFormModel _creditCardModel = new();
    private CryptoWalletFormModel _cryptoWalletModel = new();
    private SecureNoteFormModel _secureNoteModel = new();
    private GenericSecretFormModel _genericSecretModel = new();

    // The password as it was before this edit session, to detect a real change and push the old
    // value into PasswordHistory (docs/features/password-manager.md) — never set for a new item.
    private string? _originalPassword;

    // ---- Sharing (see docs/features/sharing-access-control.md "Condivisione live di singola voce") ----
    // Non-null only once this specific item has been shared: from that point on it's encrypted
    // with its own dedicated key (not the vault's DEK), even for its own owner.
    private SharedAccessResponse? _mySharedAccess;
    private IReadOnlyList<ItemMembershipResponse> _members = [];
    private Guid _ownerId;
    private bool _shareBusy;
    private string _shareEmail = string.Empty;
    private string _sharePermission = "Viewer";
    private string? _shareError;
    private string? _shareSuccess;

    protected override async Task OnParametersSetAsync()
    {
        _errorMessage = null;
        _loading = true;
        try
        {
            if (ItemId is { } id)
            {
                _isNew = false;
                var item = await VaultApi.GetItemAsync(VaultId, id);
                _effectiveType = item.Type;
                _isFavorite = item.IsFavorite;
                _folderId = item.FolderId;
                _mySharedAccess = item.MySharedAccess;
                await DecryptIntoAsync(item);

                if (_mySharedAccess is not null)
                {
                    _members = await ItemSharingApi.ListMembersAsync(id);
                    _ownerId = _members.FirstOrDefault(m => m.Permission == "Owner")?.UserId ?? Guid.Empty;
                }
            }
            else
            {
                _isNew = true;
                _effectiveType = Type ?? VaultItemTypes.Password;
                _isFavorite = false;
                _folderId = null;
                _mySharedAccess = null;
                _members = [];
                _passwordModel = new PasswordFormModel();
                _creditCardModel = new CreditCardFormModel();
                _cryptoWalletModel = new CryptoWalletFormModel();
                _secureNoteModel = new SecureNoteFormModel();
                _genericSecretModel = new GenericSecretFormModel();
                _originalPassword = null;
            }
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task DecryptIntoAsync(VaultItemResponse item)
    {
        try
        {
            byte[] key = item.MySharedAccess is { } access
                ? await ItemKeyResolver.UnwrapAsync(access.WrappedItemKey, access.EphemeralPublicKey)
                : Session.RequireDek();
            var blob = EncryptedBlob.FromBytes(item.EncryptedPayload);
            byte[] plaintext = AeadCipher.Decrypt(blob, key);

            if (item.Type == VaultItemTypes.Password)
            {
                var payload = JsonSerializer.Deserialize<PasswordPayload>(plaintext)!;
                _passwordModel = PasswordFormModel.FromPayload(payload);
                _originalPassword = payload.Password;
            }
            else if (item.Type == VaultItemTypes.CreditCard)
            {
                _creditCardModel = CreditCardFormModel.FromPayload(JsonSerializer.Deserialize<CreditCardPayload>(plaintext)!);
            }
            else if (item.Type == VaultItemTypes.CryptoWallet)
            {
                _cryptoWalletModel = CryptoWalletFormModel.FromPayload(JsonSerializer.Deserialize<CryptoWalletPayload>(plaintext)!);
            }
            else if (item.Type == VaultItemTypes.SecureNote)
            {
                _secureNoteModel = SecureNoteFormModel.FromPayload(JsonSerializer.Deserialize<SecureNotePayload>(plaintext)!);
            }
            else if (item.Type == VaultItemTypes.GenericSecret)
            {
                _genericSecretModel = GenericSecretFormModel.FromPayload(JsonSerializer.Deserialize<GenericSecretPayload>(plaintext)!);
            }
        }
        catch (CryptographicException)
        {
            _errorMessage = "Impossibile decifrare questa voce (chiave errata o dato corrotto).";
        }
    }

    private async Task SaveAsync()
    {
        _errorMessage = null;
        _busy = true;
        try
        {
            byte[]? plaintext = SerializeCurrentPlaintext();
            if (plaintext is null)
            {
                _errorMessage = $"Tipo di voce non supportato: {_effectiveType}.";
                return;
            }

            byte[] key = _mySharedAccess is { } access
                ? await ItemKeyResolver.UnwrapAsync(access.WrappedItemKey, access.EphemeralPublicKey)
                : Session.RequireDek();
            byte[] encryptedPayload = AeadCipher.Encrypt(plaintext, key).ToBytes();

            if (_isNew)
            {
                var (success, _, error) = await VaultApi.CreateItemAsync(VaultId, _effectiveType, encryptedPayload, _folderId, _isFavorite);
                if (!success)
                {
                    _errorMessage = error;
                    return;
                }
            }
            else if (_mySharedAccess is not null)
            {
                // A shared item's Type/FolderId/IsFavorite aren't editable through this path (the
                // owner still uses the normal vault-scoped route for those — this only covers the
                // ciphertext, the one thing a shared item's payload actually is).
                var response = await ItemSharingApi.UpdateSharedItemAsync(ItemId!.Value, encryptedPayload);
                if (!response.IsSuccessStatusCode)
                {
                    _errorMessage = "Impossibile salvare la voce.";
                    return;
                }
            }
            else
            {
                var (success, _, error) = await VaultApi.UpdateItemAsync(VaultId, ItemId!.Value, _effectiveType, encryptedPayload, _folderId, _isFavorite);
                if (!success)
                {
                    _errorMessage = error;
                    return;
                }
            }

            Navigation.NavigateTo($"/vault/{VaultId}");
        }
        finally
        {
            _busy = false;
        }
    }

    private byte[]? SerializeCurrentPlaintext() => _effectiveType switch
    {
        VaultItemTypes.Password => SerializePassword(),
        VaultItemTypes.CreditCard => JsonSerializer.SerializeToUtf8Bytes(_creditCardModel.ToPayload()),
        VaultItemTypes.CryptoWallet => JsonSerializer.SerializeToUtf8Bytes(_cryptoWalletModel.ToPayload()),
        VaultItemTypes.SecureNote => JsonSerializer.SerializeToUtf8Bytes(_secureNoteModel.ToPayload()),
        VaultItemTypes.GenericSecret => JsonSerializer.SerializeToUtf8Bytes(_genericSecretModel.ToPayload()),
        _ => null,
    };

    private byte[] SerializePassword()
    {
        if (!_isNew && _originalPassword is not null && _originalPassword != _passwordModel.Password)
        {
            _passwordModel.PasswordHistory.Insert(0, _originalPassword);
        }

        return JsonSerializer.SerializeToUtf8Bytes(_passwordModel.ToPayload());
    }

    private async Task ShareOrAddMemberAsync()
    {
        if (ItemId is not { } itemId || string.IsNullOrWhiteSpace(_shareEmail))
        {
            return;
        }

        _shareError = null;
        _shareSuccess = null;
        _shareBusy = true;
        try
        {
            byte[]? recipientPublicKey = await ItemSharingApi.GetPublicKeyByEmailAsync(_shareEmail);
            if (recipientPublicKey is null)
            {
                _shareError = "Utente non trovato o senza una coppia di chiavi generata.";
                return;
            }

            if (_mySharedAccess is null)
            {
                // First share: promote the item to a dedicated key.
                byte[]? plaintext = SerializeCurrentPlaintext();
                if (plaintext is null)
                {
                    _shareError = $"Tipo di voce non supportato: {_effectiveType}.";
                    return;
                }

                byte[] itemKey = RandomNumberGenerator.GetBytes(CryptoConstants.KeyLengthBytes);
                byte[] reencryptedPayload = AeadCipher.Encrypt(plaintext, itemKey).ToBytes();

                byte[] ownPublicKey = await ItemKeyResolver.GetOwnPublicKeyAsync();
                var (ownerEph, ownerWrap) = ItemKeyResolver.Wrap(ownPublicKey, itemKey);
                var (recipientEph, recipientWrap) = ItemKeyResolver.Wrap(recipientPublicKey, itemKey);

                var (success, _, error) = await ItemSharingApi.ShareAsync(
                    VaultId, itemId, _shareEmail, _sharePermission, reencryptedPayload,
                    ownerWrap, ownerEph, recipientWrap, recipientEph);

                if (!success)
                {
                    _shareError = error;
                    return;
                }

                _mySharedAccess = new SharedAccessResponse("Owner", ownerWrap, ownerEph);
            }
            else
            {
                if (_mySharedAccess.Permission != "Owner")
                {
                    _shareError = "Solo il proprietario può aggiungere altri destinatari.";
                    return;
                }

                byte[] itemKey = await ItemKeyResolver.UnwrapAsync(_mySharedAccess.WrappedItemKey, _mySharedAccess.EphemeralPublicKey);
                var (recipientEph, recipientWrap) = ItemKeyResolver.Wrap(recipientPublicKey, itemKey);

                var (success, _, error) = await ItemSharingApi.AddMemberAsync(itemId, _shareEmail, _sharePermission, recipientWrap, recipientEph);
                if (!success)
                {
                    _shareError = error;
                    return;
                }
            }

            _members = await ItemSharingApi.ListMembersAsync(itemId);
            _ownerId = _members.FirstOrDefault(m => m.Permission == "Owner")?.UserId ?? Guid.Empty;
            _shareSuccess = "Voce condivisa correttamente.";
            _shareEmail = string.Empty;
        }
        finally
        {
            _shareBusy = false;
        }
    }

    private async Task RevokeMemberAsync(Guid userId)
    {
        if (ItemId is not { } itemId)
        {
            return;
        }

        _shareError = null;
        _shareSuccess = null;
        _shareBusy = true;
        try
        {
            byte[]? plaintext = SerializeCurrentPlaintext();
            if (plaintext is null)
            {
                _shareError = $"Tipo di voce non supportato: {_effectiveType}.";
                return;
            }

            byte[] newItemKey = RandomNumberGenerator.GetBytes(CryptoConstants.KeyLengthBytes);
            byte[] reencryptedPayload = AeadCipher.Encrypt(plaintext, newItemKey).ToBytes();

            var remaining = _members.Where(m => m.UserId != userId).ToList();
            var newMemberships = new List<NewItemMembershipRequest>();
            foreach (var member in remaining)
            {
                byte[]? publicKey = await ItemSharingApi.GetPublicKeyByUserIdAsync(member.UserId);
                if (publicKey is null)
                {
                    _shareError = "Impossibile recuperare la chiave pubblica di un membro rimanente.";
                    return;
                }

                var (eph, wrapped) = ItemKeyResolver.Wrap(publicKey, newItemKey);
                newMemberships.Add(new NewItemMembershipRequest(member.UserId, wrapped, eph));
            }

            var (success, error) = await ItemSharingApi.RevokeAsync(itemId, userId, reencryptedPayload, newMemberships);
            if (!success)
            {
                _shareError = error;
                return;
            }

            var mine = newMemberships.FirstOrDefault(m => m.UserId == _ownerId);
            if (mine is not null)
            {
                _mySharedAccess = new SharedAccessResponse("Owner", mine.WrappedItemKey, mine.EphemeralPublicKey);
            }

            _members = await ItemSharingApi.ListMembersAsync(itemId);
            _shareSuccess = "Accesso revocato.";
        }
        finally
        {
            _shareBusy = false;
        }
    }

    private static string PermissionLabel(string permission) => permission switch
    {
        "Viewer" => "Sola lettura",
        "Editor" => "Modifica",
        "Owner" => "Proprietario",
        _ => permission,
    };

    private async Task RecordRevealAsync()
    {
        if (!_isNew && ItemId is { } id)
        {
            await VaultApi.RecordRevealAsync(VaultId, id);
        }
    }

    private async Task DeleteAsync()
    {
        if (ItemId is not { } id)
        {
            return;
        }

        _errorMessage = null;
        _busy = true;
        try
        {
            if (await VaultApi.DeleteItemAsync(VaultId, id))
            {
                Navigation.NavigateTo($"/vault/{VaultId}");
            }
            else
            {
                _errorMessage = "Impossibile eliminare la voce.";
            }
        }
        finally
        {
            _busy = false;
        }
    }
}
