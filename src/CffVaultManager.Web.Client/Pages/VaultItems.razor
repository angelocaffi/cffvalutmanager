@page "/vault/{VaultId:guid}"
@attribute [Authorize]
@using System.Text.Json
@using CffVaultManager.Crypto
@using CffVaultManager.Crypto.Abstractions
@using CffVaultManager.Web.Client.Models
@inject VaultApiClient VaultApi
@inject IAeadCipherService AeadCipher
@inject NavigationManager Navigation
@inject ItemKeyResolver ItemKeyResolver
@inject VaultDekResolver VaultDekResolver
@inject ClipboardJsInterop Clipboard

<PageTitle>Vault</PageTitle>

@if (_errorMessage is not null)
{
    <div class="alert alert-danger py-2" role="alert">@_errorMessage</div>
}

@if (_items is null)
{
    <div class="d-flex align-items-center gap-2 text-body-secondary">
        <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
        <span>Caricamento…</span>
    </div>
}
else
{
    var visible = _items.Where(MatchesFilter).ToList();

    <div class="vault-shell">
        <aside class="vault-sidebar @(_selectedId is null ? "d-flex" : "d-none d-lg-flex")">
            <div class="vault-sidebar-card">
                <div class="dropdown">
                    <button class="btn btn-info dropdown-toggle w-100 btn-sm" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                        Nuova voce
                    </button>
                    <ul class="dropdown-menu">
                        <li><a class="dropdown-item" href="@NewItemUrl(VaultItemTypes.Password)">Password</a></li>
                        <li><a class="dropdown-item" href="@NewItemUrl(VaultItemTypes.CreditCard)">Carta di credito</a></li>
                        <li><a class="dropdown-item" href="@NewItemUrl(VaultItemTypes.CryptoWallet)">Crypto wallet</a></li>
                        <li><a class="dropdown-item" href="@NewItemUrl(VaultItemTypes.SecureNote)">Nota sicura</a></li>
                        <li><a class="dropdown-item" href="@NewItemUrl(VaultItemTypes.GenericSecret)">Secret generico</a></li>
                    </ul>
                </div>

                <div class="vault-sidebar-scope">
                    <button type="button" class="vault-scope-link @(!_favoritesOnly && _selectedFolderId is null ? "active" : null)" @onclick="() => SetScope(null, false)">
                        <span>Tutte le voci</span>
                        <span class="vault-count-badge">@_items.Count</span>
                    </button>
                    <button type="button" class="vault-scope-link @(_favoritesOnly ? "active" : null)" @onclick="() => SetScope(_selectedFolderId, true)">
                        <span>★ Preferiti</span>
                        <span class="vault-count-badge">@_items.Count(i => i.IsFavorite)</span>
                    </button>
                </div>

                <div class="vault-sidebar-facet">
                    <div class="vault-sidebar-heading">Tipo</div>
                    <div class="vault-chip-row">
                        @foreach (var type in AllTypes)
                        {
                            <button type="button" class="vault-chip @(_typeFilter == type ? "active" : null)" @onclick="() => ToggleTypeFilter(type)">
                                @TypeLabel(type)
                                <span class="vault-chip-count">@_items.Count(i => i.Type == type)</span>
                            </button>
                        }
                    </div>
                </div>

                <div class="vault-sidebar-facet">
                    <div class="vault-sidebar-heading">Cartelle</div>
                    @if (_folders.Count > 0)
                    {
                        <div class="vault-chip-row">
                            @foreach (var folder in _folders)
                            {
                                <button type="button" class="vault-chip @(_selectedFolderId == folder.Id ? "active" : null)" @onclick="() => SetScope(folder.Id, _favoritesOnly)">
                                    <span class="vault-chip-label">@folder.Name</span>
                                    <span class="vault-chip-count">@_items.Count(i => i.FolderId == folder.Id)</span>
                                </button>
                            }
                        </div>
                    }
                    <form class="d-flex gap-1 mt-2" @onsubmit="CreateFolderAsync" @onsubmit:preventDefault="true">
                        <input class="form-control form-control-sm" placeholder="Nuova cartella…" @bind="_newFolderName" @bind:event="oninput" />
                        <button type="submit" class="btn btn-outline-secondary btn-sm" disabled="@string.IsNullOrWhiteSpace(_newFolderName)">+</button>
                    </form>
                </div>

                <div class="vault-sidebar-footer">
                    @if (_vaultAccess?.IsOrganizationVault == true)
                    {
                        <a href="@($"/vault/{VaultId}/members")">Gestisci membri</a>
                    }
                    <a href="@($"/vault/{VaultId}/backup")">Backup</a>
                    <a href="@($"/vault/{VaultId}/trash")">Cestino</a>
                </div>
            </div>
        </aside>

        <section class="vault-list-pane @(_selectedId is null ? "d-flex" : "d-none d-lg-flex")">
            <input type="search" class="form-control mb-2" placeholder="Cerca…" @bind="_searchText" @bind:event="oninput" />

            @if (visible.Count == 0)
            {
                <EmptyState Message="Nessuna voce trovata." />
            }
            else
            {
                <div class="vault-row-list">
                    @foreach (var item in visible)
                    {
                        var summary = _summaries.GetValueOrDefault(item.Id) ?? new DecryptedSummary("(non decifrabile)", null);
                        @* Not a <button>: it hosts its own nested <button>/<a> quick actions, and
                           interactive content can't nest inside a native <button> — role="button"
                           + tabindex + the keydown handler below keep it keyboard-operable instead. *@
                        <div class="vault-row @(_selectedId == item.Id ? "active" : null)" role="button" tabindex="0"
                             @onclick="() => SelectAsync(item)"
                             @onkeydown="@(async e => { if (e.Key is "Enter" or " ") { await SelectAsync(item); } })">
                            <span class="vault-row-icon vault-row-icon-@IconSlug(item.Type)" title="@TypeLabel(item.Type)">
                                @if (item.Type == VaultItemTypes.Password)
                                {
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 5.25a3.75 3.75 0 1 1-3.675 4.5H4.5v3h2.25v3H9v-3h1.5l1.575-1.575A3.75 3.75 0 0 1 15.75 5.25Z" /><circle cx="16.5" cy="9" r="0.75" fill="currentColor" stroke="none" /></svg>
                                }
                                else if (item.Type == VaultItemTypes.CreditCard)
                                {
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="3" y="6" width="18" height="12" rx="1.5" /><path d="M3 10h18M6.5 14.5h3" /></svg>
                                }
                                else if (item.Type == VaultItemTypes.CryptoWallet)
                                {
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M3.75 7.5A1.5 1.5 0 0 1 5.25 6h12a1.5 1.5 0 0 1 1.5 1.5v1.25h-3.25a2.25 2.25 0 0 0 0 4.5h3.25v1.25a1.5 1.5 0 0 1-1.5 1.5h-12a1.5 1.5 0 0 1-1.5-1.5v-7Z" /><circle cx="15.5" cy="10.75" r="0.75" fill="currentColor" stroke="none" /></svg>
                                }
                                else if (item.Type == VaultItemTypes.SecureNote)
                                {
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path stroke-linejoin="round" d="M6.75 3.75h7.5l4 4v12a1 1 0 0 1-1 1h-10.5a1 1 0 0 1-1-1V4.75a1 1 0 0 1 1-1Z" /><path d="M9 12h6M9 15.5h6M9 8.5h3" /></svg>
                                }
                                else
                                {
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3.75c-3 0-4.5 1.5-4.5 3.375 0 1.5.9 2.325 1.988 3.169C10.462 11.006 11.25 11.7 11.25 13.125V14.25M12 17.25v.75" /><circle cx="12" cy="12" r="8.25" /></svg>
                                }
                            </span>
                            <span class="vault-row-text">
                                <span class="vault-row-title">@summary.Title</span>
                                @if (!string.IsNullOrEmpty(summary.Subtitle))
                                {
                                    <span class="vault-row-subtitle">@summary.Subtitle</span>
                                }
                            </span>
                            @if (item.IsFavorite)
                            {
                                <span class="vault-row-star" title="Preferito">★</span>
                            }
                            <span class="vault-row-actions" @onclick:stopPropagation="true">
                                @if (!string.IsNullOrEmpty(summary.QuickUsername))
                                {
                                    <button type="button" class="vault-row-action" title="Copia username" @onclick="() => CopyAsync(summary.QuickUsername)">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="12" cy="8.25" r="3" /><path stroke-linecap="round" d="M5.25 19.5a6.75 6.75 0 0 1 13.5 0" /></svg>
                                    </button>
                                }
                                @if (!string.IsNullOrEmpty(summary.QuickPassword))
                                {
                                    <button type="button" class="vault-row-action" title="Copia password" @onclick="() => CopySensitiveQuickAsync(item.Id, summary.QuickPassword)">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 5.25a3.75 3.75 0 1 1-3.675 4.5H4.5v3h2.25v3H9v-3h1.5l1.575-1.575A3.75 3.75 0 0 1 15.75 5.25Z" /><circle cx="16.5" cy="9" r="0.75" fill="currentColor" stroke="none" /></svg>
                                    </button>
                                }
                                <a class="vault-row-action" title="Apri" href="@ItemUrl(item.Id)">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5h6v6M19.5 4.5 10 14M9 4.5H6a1.5 1.5 0 0 0-1.5 1.5v12A1.5 1.5 0 0 0 6 19.5h12a1.5 1.5 0 0 0 1.5-1.5v-3" /></svg>
                                </a>
                            </span>
                        </div>
                    }
                </div>
            }
        </section>

        <section class="vault-detail-pane @(_selectedId is null ? "d-none d-lg-flex" : "d-flex")">
            @{ var selectedItem = _selectedId is { } sid ? _items.FirstOrDefault(i => i.Id == sid) : null; }
            @if (selectedItem is null)
            {
                <EmptyState Message="Seleziona una voce dall'elenco per vederne i dettagli." />
            }
            else
            {
                <div class="d-flex align-items-center gap-2 mb-3">
                    <button type="button" class="btn btn-outline-secondary btn-sm d-lg-none" @onclick="() => _selectedId = null">← Indietro</button>
                    <span class="badge text-bg-secondary">@TypeLabel(selectedItem.Type)</span>
                    <h2 class="h5 mb-0 text-truncate flex-grow-1 vault-detail-title">@(_summaries.GetValueOrDefault(selectedItem.Id)?.Title ?? "…")</h2>
                    <button type="button" class="btn btn-link p-0" title="Preferito" disabled="@_busy" @onclick="() => ToggleFavoriteAsync(selectedItem)">
                        @(selectedItem.IsFavorite ? "★" : "☆")
                    </button>
                </div>

                @if (_detailLoading)
                {
                    <div class="d-flex align-items-center gap-2 text-body-secondary">
                        <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                        <span>Decifratura…</span>
                    </div>
                }
                else if (_selectedPayload is null)
                {
                    <div class="alert alert-warning py-2" role="alert">Impossibile decifrare questa voce.</div>
                }
                else
                {
                    <div class="d-flex justify-content-end mb-2">
                        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="ToggleRevealSelectedAsync">
                            @(_selectedRevealed ? "Nascondi campi sensibili" : "Mostra campi sensibili")
                        </button>
                    </div>

                    @if (_selectedPayload is PasswordPayload pw)
                    {
                        <div class="mb-3">
                            <label class="form-label small text-body-secondary">Username</label>
                            <div class="input-group">
                                <input class="form-control" readonly value="@(pw.Username ?? "—")" />
                                <button type="button" class="btn btn-outline-secondary" @onclick="() => CopyAsync(pw.Username)">Copia</button>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label small text-body-secondary">Password</label>
                            <div class="input-group">
                                <input class="form-control font-monospace" readonly value="@(_selectedRevealed ? pw.Password : Mask(pw.Password))" />
                                <button type="button" class="btn btn-outline-secondary" @onclick="() => CopySensitiveAsync(pw.Password)">Copia</button>
                            </div>
                        </div>
                        @if (!string.IsNullOrEmpty(pw.Url))
                        {
                            <div class="mb-3"><label class="form-label small text-body-secondary">URL</label><div><a href="@pw.Url" target="_blank" rel="noopener noreferrer">@pw.Url</a></div></div>
                        }
                        @if (!string.IsNullOrEmpty(pw.Notes))
                        {
                            <div class="mb-3"><label class="form-label small text-body-secondary">Note</label><p class="mb-0">@pw.Notes</p></div>
                        }
                    }
                    else if (_selectedPayload is CreditCardPayload cc)
                    {
                        <div class="mb-3"><label class="form-label small text-body-secondary">Intestatario</label><div>@cc.CardholderName</div></div>
                        <div class="mb-3">
                            <label class="form-label small text-body-secondary">Numero carta</label>
                            <div class="input-group">
                                <input class="form-control font-monospace" readonly value="@(_selectedRevealed ? cc.CardNumber : Mask(cc.CardNumber))" />
                                <button type="button" class="btn btn-outline-secondary" @onclick="() => CopySensitiveAsync(cc.CardNumber)">Copia</button>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label small text-body-secondary">CVV</label>
                            <div class="input-group" style="max-width: 10rem;">
                                <input class="form-control font-monospace" readonly value="@(_selectedRevealed ? cc.Cvv : Mask(cc.Cvv))" />
                                <button type="button" class="btn btn-outline-secondary" @onclick="() => CopySensitiveAsync(cc.Cvv)">Copia</button>
                            </div>
                        </div>
                        <div class="mb-3"><label class="form-label small text-body-secondary">Scadenza</label><div>@(cc.ExpiryMonth?.ToString("D2") ?? "--")/@cc.ExpiryYear</div></div>
                    }
                    else if (_selectedPayload is CryptoWalletPayload wallet)
                    {
                        @if (!string.IsNullOrEmpty(wallet.Network))
                        {
                            <div class="mb-3"><label class="form-label small text-body-secondary">Rete</label><div>@wallet.Network</div></div>
                        }
                        @foreach (var address in wallet.Addresses)
                        {
                            <div class="mb-3">
                                <label class="form-label small text-body-secondary">Indirizzo</label>
                                <div class="input-group">
                                    <input class="form-control font-monospace" readonly value="@address" />
                                    <button type="button" class="btn btn-outline-secondary" @onclick="() => CopyAsync(address)">Copia</button>
                                </div>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(wallet.PrivateKey))
                        {
                            <div class="mb-3">
                                <label class="form-label small text-body-secondary">Chiave privata</label>
                                <div class="input-group">
                                    <input class="form-control font-monospace" readonly value="@(_selectedRevealed ? wallet.PrivateKey : Mask(wallet.PrivateKey))" />
                                    <button type="button" class="btn btn-outline-secondary" @onclick="() => CopySensitiveAsync(wallet.PrivateKey)">Copia</button>
                                </div>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(wallet.Mnemonic))
                        {
                            <div class="mb-3">
                                <label class="form-label small text-body-secondary">Seed phrase</label>
                                <div class="input-group">
                                    <input class="form-control font-monospace" readonly value="@(_selectedRevealed ? wallet.Mnemonic : Mask(wallet.Mnemonic))" />
                                    <button type="button" class="btn btn-outline-secondary" @onclick="() => CopySensitiveAsync(wallet.Mnemonic)">Copia</button>
                                </div>
                            </div>
                        }
                    }
                    else if (_selectedPayload is SecureNotePayload note)
                    {
                        <div class="mb-3"><p class="mb-0" style="white-space: pre-wrap;">@note.Content</p></div>
                    }
                    else if (_selectedPayload is GenericSecretPayload generic)
                    {
                        @foreach (var field in generic.Fields)
                        {
                            <div class="mb-3">
                                <label class="form-label small text-body-secondary">@field.Key</label>
                                <div class="input-group">
                                    <input class="form-control font-monospace" readonly value="@(_selectedRevealed ? field.Value : Mask(field.Value))" />
                                    <button type="button" class="btn btn-outline-secondary" @onclick="() => CopySensitiveAsync(field.Value)">Copia</button>
                                </div>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(generic.Notes))
                        {
                            <div class="mb-3"><label class="form-label small text-body-secondary">Note</label><p class="mb-0">@generic.Notes</p></div>
                        }
                    }

                    <div class="mb-3">
                        <label class="form-label small text-body-secondary">Cartella</label>
                        <select class="form-select form-select-sm" style="max-width: 16rem;" value="@(selectedItem.FolderId?.ToString() ?? "")" @onchange="e => MoveToFolderAsync(selectedItem, e.Value?.ToString())">
                            <option value="">Nessuna cartella</option>
                            @foreach (var folder in _folders)
                            {
                                <option value="@folder.Id">@folder.Name</option>
                            }
                        </select>
                    </div>
                }

                <div class="d-flex gap-2 mt-auto pt-3">
                    <a class="btn btn-info btn-sm" href="@ItemUrl(selectedItem.Id)">Apri / Modifica</a>
                    <button type="button" class="btn btn-outline-danger btn-sm" disabled="@_busy" @onclick="() => DeleteSelectedAsync(selectedItem)">Elimina</button>
                </div>
            }
        </section>
    </div>
}

@code {
    private static readonly string[] AllTypes =
    [
        VaultItemTypes.Password, VaultItemTypes.CreditCard, VaultItemTypes.CryptoWallet,
        VaultItemTypes.SecureNote, VaultItemTypes.GenericSecret
    ];

    [Parameter]
    public Guid VaultId { get; set; }

    private IReadOnlyList<VaultItemResponse>? _items;
    private VaultAccess? _vaultAccess;
    private readonly Dictionary<Guid, DecryptedSummary> _summaries = new();
    private IReadOnlyList<FolderResponse> _folders = [];
    private string _newFolderName = string.Empty;

    private string _searchText = string.Empty;
    private string _typeFilter = string.Empty;
    private Guid? _selectedFolderId;
    private bool _favoritesOnly;

    private Guid? _selectedId;
    private object? _selectedPayload;
    private bool _selectedRevealed;
    private bool _detailLoading;

    private string? _errorMessage;
    private bool _busy;

    protected override async Task OnParametersSetAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        _errorMessage = null;
        try
        {
            _items = await VaultApi.ListItemsAsync(VaultId);
            _folders = await VaultApi.ListFoldersAsync(VaultId);
        }
        catch (HttpRequestException)
        {
            // Most likely this vault was revoked (or deleted) since the page was last loaded —
            // e.g. an Owner revoked this member's access to an organization vault in another tab.
            _items = [];
            _errorMessage = "Impossibile accedere a questo vault. Potresti non farne più parte.";
            return;
        }

        _vaultAccess = await VaultDekResolver.ResolveAsync(VaultId);
        byte[] dek = _vaultAccess.Dek;
        _summaries.Clear();
        foreach (var item in _items)
        {
            // Once an item has been shared it's encrypted with its own dedicated key, not the
            // vault's DEK — see docs/features/sharing-access-control.md.
            byte[] key = item.MySharedAccess is { } access
                ? await ItemKeyResolver.UnwrapAsync(access.WrappedItemKey, access.EphemeralPublicKey)
                : dek;
            _summaries[item.Id] = Summarize(item, key);
        }

        if (_selectedId is { } id && _items.All(i => i.Id != id))
        {
            _selectedId = null;
            _selectedPayload = null;
        }
    }

    private DecryptedSummary Summarize(VaultItemResponse item, byte[] dek)
    {
        try
        {
            var blob = EncryptedBlob.FromBytes(item.EncryptedPayload);
            byte[] plaintext = AeadCipher.Decrypt(blob, dek);

            return item.Type switch
            {
                VaultItemTypes.Password => FromPassword(JsonSerializer.Deserialize<PasswordPayload>(plaintext)!),
                VaultItemTypes.CreditCard => FromCreditCard(JsonSerializer.Deserialize<CreditCardPayload>(plaintext)!),
                VaultItemTypes.CryptoWallet => FromCryptoWallet(JsonSerializer.Deserialize<CryptoWalletPayload>(plaintext)!),
                VaultItemTypes.SecureNote => FromSecureNote(JsonSerializer.Deserialize<SecureNotePayload>(plaintext)!),
                VaultItemTypes.GenericSecret => FromGenericSecret(JsonSerializer.Deserialize<GenericSecretPayload>(plaintext)!),
                _ => new DecryptedSummary("(tipo sconosciuto)", null),
            };
        }
        catch
        {
            // Wrong/rotated DEK, corrupted ciphertext, or a payload shape this client version
            // doesn't recognize — never crash the whole list over one bad item.
            return new DecryptedSummary("(non decifrabile)", null);
        }
    }

    // QuickUsername/QuickPassword back the hover "copy" actions in the row list — no extra
    // decryption cost, since Summarize() already fully decrypts the payload above just to read
    // Title/Subtitle out of it; this only keeps two more fields already sitting in memory.
    private static DecryptedSummary FromPassword(PasswordPayload payload) =>
        new(payload.Title, payload.Username, payload.Username, payload.Password);

    private static DecryptedSummary FromCreditCard(CreditCardPayload payload)
    {
        string last4 = payload.CardNumber.Length >= 4 ? payload.CardNumber[^4..] : payload.CardNumber;
        string subtitle = string.IsNullOrEmpty(payload.Brand) ? $"•••• {last4}" : $"{payload.Brand} •••• {last4}";
        return new DecryptedSummary(payload.Title, subtitle);
    }

    private static DecryptedSummary FromCryptoWallet(CryptoWalletPayload payload)
    {
        string? subtitle = payload.Network;
        if (payload.Addresses.Count > 0)
        {
            string address = payload.Addresses[0];
            string masked = address.Length > 8 ? $"{address[..4]}…{address[^4..]}" : address;
            subtitle = subtitle is null ? masked : $"{subtitle} · {masked}";
        }

        return new DecryptedSummary(payload.Label, subtitle);
    }

    private static DecryptedSummary FromSecureNote(SecureNotePayload payload)
    {
        string? preview = string.IsNullOrWhiteSpace(payload.Content) ? null : payload.Content.Length > 60 ? $"{payload.Content[..60]}…" : payload.Content;
        return new DecryptedSummary(payload.Title, preview);
    }

    private static DecryptedSummary FromGenericSecret(GenericSecretPayload payload)
    {
        string? subtitle = payload.Fields.Count > 0 ? string.Join(", ", payload.Fields.Select(f => f.Key)) : null;
        return new DecryptedSummary(payload.Title, subtitle);
    }

    private bool MatchesFilter(VaultItemResponse item)
    {
        if (_favoritesOnly && !item.IsFavorite)
        {
            return false;
        }

        if (_selectedFolderId is { } folderId && item.FolderId != folderId)
        {
            return false;
        }

        if (!string.IsNullOrEmpty(_typeFilter) && item.Type != _typeFilter)
        {
            return false;
        }

        if (string.IsNullOrWhiteSpace(_searchText))
        {
            return true;
        }

        var summary = _summaries.GetValueOrDefault(item.Id);
        return (summary?.Title.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ?? false)
            || (summary?.Subtitle?.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ?? false);
    }

    private void SetScope(Guid? folderId, bool favoritesOnly)
    {
        _selectedFolderId = folderId;
        _favoritesOnly = favoritesOnly;
    }

    private void ToggleTypeFilter(string type) => _typeFilter = _typeFilter == type ? string.Empty : type;

    private async Task CreateFolderAsync()
    {
        if (string.IsNullOrWhiteSpace(_newFolderName))
        {
            return;
        }

        try
        {
            await VaultApi.CreateFolderAsync(VaultId, _newFolderName.Trim());
        }
        catch (HttpRequestException)
        {
            _errorMessage = "Impossibile creare la cartella.";
            return;
        }

        _newFolderName = string.Empty;
        _folders = await VaultApi.ListFoldersAsync(VaultId);
    }

    private async Task SelectAsync(VaultItemResponse item)
    {
        _selectedId = item.Id;
        _selectedPayload = null;
        _selectedRevealed = false;
        _detailLoading = true;
        StateHasChanged();

        _selectedPayload = await DecryptFullPayloadAsync(item);
        _detailLoading = false;
    }

    private async Task<object?> DecryptFullPayloadAsync(VaultItemResponse item)
    {
        try
        {
            byte[] dek = (_vaultAccess ?? await VaultDekResolver.ResolveAsync(VaultId)).Dek;
            byte[] key = item.MySharedAccess is { } access
                ? await ItemKeyResolver.UnwrapAsync(access.WrappedItemKey, access.EphemeralPublicKey)
                : dek;
            var blob = EncryptedBlob.FromBytes(item.EncryptedPayload);
            byte[] plaintext = AeadCipher.Decrypt(blob, key);

            return item.Type switch
            {
                VaultItemTypes.Password => JsonSerializer.Deserialize<PasswordPayload>(plaintext),
                VaultItemTypes.CreditCard => JsonSerializer.Deserialize<CreditCardPayload>(plaintext),
                VaultItemTypes.CryptoWallet => JsonSerializer.Deserialize<CryptoWalletPayload>(plaintext),
                VaultItemTypes.SecureNote => JsonSerializer.Deserialize<SecureNotePayload>(plaintext),
                VaultItemTypes.GenericSecret => JsonSerializer.Deserialize<GenericSecretPayload>(plaintext),
                _ => null,
            };
        }
        catch
        {
            return null;
        }
    }

    private async Task ToggleRevealSelectedAsync()
    {
        _selectedRevealed = !_selectedRevealed;
        if (_selectedRevealed && _selectedId is { } id)
        {
            await VaultApi.RecordRevealAsync(VaultId, id);
        }
    }

    private async Task CopyAsync(string? value)
    {
        if (!string.IsNullOrEmpty(value))
        {
            await Clipboard.CopyWithAutoClearAsync(value);
        }
    }

    private async Task CopySensitiveAsync(string? value)
    {
        if (string.IsNullOrEmpty(value))
        {
            return;
        }

        if (_selectedId is { } id)
        {
            await VaultApi.RecordRevealAsync(VaultId, id);
        }

        await Clipboard.CopyWithAutoClearAsync(value);
    }

    // Same as CopySensitiveAsync, but for the row list's hover "copy password" action, which can
    // fire on any visible row — not just the currently selected/opened one — so the item id has
    // to be passed in explicitly instead of read off _selectedId.
    private async Task CopySensitiveQuickAsync(Guid itemId, string? value)
    {
        if (string.IsNullOrEmpty(value))
        {
            return;
        }

        await VaultApi.RecordRevealAsync(VaultId, itemId);
        await Clipboard.CopyWithAutoClearAsync(value);
    }

    private static string Mask(string? value) => string.IsNullOrEmpty(value) ? "—" : new string('•', Math.Min(value.Length, 16));

    private async Task MoveToFolderAsync(VaultItemResponse item, string? folderIdText)
    {
        Guid? folderId = Guid.TryParse(folderIdText, out var parsed) ? parsed : null;

        _errorMessage = null;
        _busy = true;
        try
        {
            var (success, _, error) = await VaultApi.UpdateItemAsync(
                VaultId, item.Id, item.Type, item.EncryptedPayload, folderId, item.IsFavorite);
            if (!success)
            {
                _errorMessage = error;
                return;
            }

            await ReloadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ToggleFavoriteAsync(VaultItemResponse item)
    {
        _errorMessage = null;
        _busy = true;
        try
        {
            var (success, _, error) = await VaultApi.UpdateItemAsync(
                VaultId, item.Id, item.Type, item.EncryptedPayload, item.FolderId, !item.IsFavorite);
            if (!success)
            {
                _errorMessage = error;
                return;
            }

            await ReloadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DeleteSelectedAsync(VaultItemResponse item)
    {
        _errorMessage = null;
        _busy = true;
        try
        {
            if (!await VaultApi.DeleteItemAsync(VaultId, item.Id))
            {
                _errorMessage = "Impossibile eliminare la voce.";
                return;
            }

            _selectedId = null;
            _selectedPayload = null;
            await ReloadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

