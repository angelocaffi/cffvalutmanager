@page "/register"
@using System.Security.Cryptography
@using CffVaultManager.Crypto
@using CffVaultManager.Crypto.Abstractions
@inject AuthApiClient AuthApi
@inject IKeyDerivationService KeyDerivation
@inject IAuthHashService AuthHashService
@inject IDekService DekService
@inject NavigationManager Navigation

<PageTitle>Crea organizzazione</PageTitle>

<div class="auth-shell">
    <div class="auth-panel">
        <div class="auth-brand-panel d-none d-lg-flex">
            <div class="auth-brand-panel-content">
                <BrandMark IconClass="auth-brand-icon mb-2 d-block mx-auto" TextClass="auth-brand-text d-block" />
                <p class="auth-brand-tagline">Ogni segreto della tua organizzazione resta cifrato end-to-end — nemmeno noi possiamo leggerlo.</p>
            </div>
        </div>
        <div class="auth-form-panel">
            <div class="auth-form-panel-inner">
                <div class="d-flex align-items-center justify-content-center gap-2 mb-3 d-lg-none">
                    <BrandMark IconClass="login-logo" TextClass="fs-5" />
                </div>
                <h1 class="h4 mb-4 text-primary text-center">Crea la tua organizzazione</h1>

            @if (_step == Step.Done)
            {
                <p class="text-success">Organizzazione creata. Puoi ora accedere con le credenziali appena scelte.</p>
                <a class="btn btn-info w-100" href="/login">Vai al login</a>
            }
            else if (_step == Step.Confirm)
            {
                <p class="text-body-secondary small">
                    Abbiamo inviato un codice di conferma a <strong>@_adminEmail</strong>. Inseriscilo per completare la creazione dell'organizzazione.
                </p>

                <form @onsubmit="HandleConfirmAsync" @onsubmit:preventDefault="true">
                    <div class="mb-3">
                        <label for="reg-code" class="form-label">Codice di conferma</label>
                        <input id="reg-code" class="form-control" @bind="_code" @bind:event="oninput"
                               required disabled="@_busy" inputmode="numeric" pattern="[0-9]{6}" maxlength="6"
                               autocomplete="one-time-code" />
                    </div>

                    @if (_errorMessage is not null)
                    {
                        <div class="alert alert-danger py-2" role="alert">@_errorMessage</div>
                    }

                    <button type="submit" class="btn btn-info w-100" disabled="@_busy">
                        @if (_busy)
                        {
                            <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                        }
                        @(_busy ? "Conferma in corso…" : "Conferma")
                    </button>
                </form>

                <p class="text-center small text-body-secondary mt-3 mb-0">
                    <a href="#" @onclick="BackToForm" @onclick:preventDefault="true">Torna al modulo</a>
                </p>
            }
            else
            {
                <form @onsubmit="HandleSubmitAsync" @onsubmit:preventDefault="true">
                    <div class="mb-3">
                        <label for="reg-org-name" class="form-label">Nome organizzazione</label>
                        <input id="reg-org-name" class="form-control" @bind="_tenantName" @bind:event="oninput"
                               @bind:after="SyncSlugFromName" required disabled="@_busy" />
                    </div>
                    <div class="mb-3">
                        <label for="reg-org-slug" class="form-label">Identificativo (slug)</label>
                        <input id="reg-org-slug" class="form-control" @bind="_tenantSlug" @bind:event="oninput"
                               @bind:after="() => _slugManuallyEdited = true" required disabled="@_busy" pattern="[a-z0-9\-]+" />
                        <div class="form-text">Solo lettere minuscole, numeri e trattini. Deve essere univoco.</div>
                    </div>
                    <div class="mb-3">
                        <label for="reg-email" class="form-label">Email amministratore</label>
                        <input id="reg-email" type="email" class="form-control" @bind="_adminEmail" @bind:event="oninput"
                               required disabled="@_busy" autocomplete="username" />
                    </div>
                    <div class="mb-3">
                        <label for="reg-password" class="form-label">Master password</label>
                        <input id="reg-password" type="password" class="form-control" @bind="_masterPassword" @bind:event="oninput"
                               required disabled="@_busy" minlength="12" autocomplete="new-password" />
                        <div class="form-text">Almeno 12 caratteri. Non lascia mai il browser: viene usata solo per derivare la chiave di cifratura.</div>
                    </div>
                    <div class="mb-3">
                        <label for="reg-password-confirm" class="form-label">Conferma master password</label>
                        <input id="reg-password-confirm" type="password" class="form-control" @bind="_masterPasswordConfirm" @bind:event="oninput"
                               required disabled="@_busy" autocomplete="new-password" />
                    </div>

                    <hr class="my-4" />
                    <h2 class="h6 mb-3">Dati di fatturazione</h2>
                    <p class="text-body-secondary small">
                        Usati solo per un futuro piano a pagamento e per l'eventuale fattura — mai per accedere ai tuoi secrets.
                    </p>

                    <div class="mb-3">
                        <label for="reg-billing-subject" class="form-label">Tipo soggetto</label>
                        <select id="reg-billing-subject" class="form-select" @bind="_isBusinessSelection" disabled="@_busy">
                            <option value="private">Privato</option>
                            <option value="business">Azienda</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="reg-legal-name" class="form-label">@(_isBusiness ? "Ragione sociale" : "Nome e cognome")</label>
                        <input id="reg-legal-name" class="form-control" @bind="_legalName" @bind:event="oninput"
                               required disabled="@_busy" />
                    </div>
                    @if (_isBusiness)
                    {
                        <div class="mb-3">
                            <label for="reg-vat" class="form-label">Partita IVA</label>
                            <input id="reg-vat" class="form-control" @bind="_vatNumber" @bind:event="oninput"
                                   required disabled="@_busy" />
                        </div>
                    }
                    else
                    {
                        <div class="mb-3">
                            <label for="reg-tax-code" class="form-label">Codice Fiscale</label>
                            <input id="reg-tax-code" class="form-control" @bind="_taxCode" @bind:event="oninput"
                                   required disabled="@_busy" />
                        </div>
                    }
                    <div class="mb-3">
                        <label for="reg-address" class="form-label">Indirizzo</label>
                        <input id="reg-address" class="form-control" @bind="_addressLine" @bind:event="oninput"
                               required disabled="@_busy" />
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-sm-6">
                            <label for="reg-city" class="form-label">Città</label>
                            <input id="reg-city" class="form-control" @bind="_city" @bind:event="oninput"
                                   required disabled="@_busy" />
                        </div>
                        <div class="col-sm-3">
                            <label for="reg-postal-code" class="form-label">CAP</label>
                            <input id="reg-postal-code" class="form-control" @bind="_postalCode" @bind:event="oninput"
                                   required disabled="@_busy" />
                        </div>
                        <div class="col-sm-3">
                            <label for="reg-province" class="form-label">Provincia</label>
                            <input id="reg-province" class="form-control" @bind="_province" @bind:event="oninput"
                                   required disabled="@_busy" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label for="reg-country" class="form-label">Paese</label>
                        <input id="reg-country" class="form-control" @bind="_country" @bind:event="oninput"
                               required disabled="@_busy" />
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-sm-6">
                            <label for="reg-sdi" class="form-label">Codice Destinatario SDI</label>
                            <input id="reg-sdi" class="form-control" @bind="_sdiCode" @bind:event="oninput" disabled="@_busy" />
                        </div>
                        <div class="col-sm-6">
                            <label for="reg-pec" class="form-label">PEC</label>
                            <input id="reg-pec" type="email" class="form-control" @bind="_pecAddress" @bind:event="oninput" disabled="@_busy" />
                        </div>
                    </div>
                    <div class="form-text mb-3">Per la fatturazione elettronica in Italia: uno tra Codice Destinatario SDI e PEC, se disponibili.</div>
                    <div class="mb-3">
                        <label for="reg-phone" class="form-label">Telefono (opzionale)</label>
                        <input id="reg-phone" type="tel" class="form-control" @bind="_phone" @bind:event="oninput" disabled="@_busy" />
                    </div>

                    @if (_errorMessage is not null)
                    {
                        <div class="alert alert-danger py-2" role="alert">@_errorMessage</div>
                    }

                    <button type="submit" class="btn btn-info w-100" disabled="@_busy">
                        @if (_busy)
                        {
                            <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                        }
                        @(_busy ? "Invio in corso…" : "Crea organizzazione")
                    </button>
                </form>

                <p class="text-center small text-body-secondary mt-3 mb-0">
                    Hai già un account? <a href="/login">Accedi</a>
                </p>
            }
            </div>
        </div>
    </div>
</div>

@code {
    private enum Step { Form, Confirm, Done }

    private Step _step = Step.Form;

    private string _tenantName = string.Empty;
    private string _tenantSlug = string.Empty;
    private bool _slugManuallyEdited;
    private string _adminEmail = string.Empty;
    private string _masterPassword = string.Empty;
    private string _masterPasswordConfirm = string.Empty;

    private bool _isBusiness;
    private string _isBusinessSelection
    {
        get => _isBusiness ? "business" : "private";
        set => _isBusiness = value == "business";
    }
    private string _legalName = string.Empty;
    private string _vatNumber = string.Empty;
    private string _taxCode = string.Empty;
    private string _addressLine = string.Empty;
    private string _city = string.Empty;
    private string _postalCode = string.Empty;
    private string _province = string.Empty;
    private string _country = string.Empty;
    private string _sdiCode = string.Empty;
    private string _pecAddress = string.Empty;
    private string _phone = string.Empty;

    private Guid? _requestId;
    private string _code = string.Empty;

    private string? _errorMessage;
    private bool _busy;

    private void SyncSlugFromName()
    {
        if (_slugManuallyEdited)
        {
            return;
        }

        _tenantSlug = Slugify(_tenantName);
    }

    private async Task HandleSubmitAsync()
    {
        _errorMessage = null;

        if (_masterPassword != _masterPasswordConfirm)
        {
            _errorMessage = "Le due master password non coincidono.";
            return;
        }

        if (_masterPassword.Length < 12)
        {
            _errorMessage = "La master password deve avere almeno 12 caratteri.";
            return;
        }

        _busy = true;
        try
        {
            byte[] salt = RandomNumberGenerator.GetBytes(16);
            var kdfParams = Argon2Parameters.Default;

            using var kek = await KeyDerivation.DeriveKekAsync(_masterPassword, salt, kdfParams);
            byte[] authHash = AuthHashService.DeriveAuthHash(kek, _masterPassword);

            byte[] dek = DekService.GenerateDek();
            byte[] encryptedDek = DekService.EncryptDek(dek, kek.Key).ToBytes();
            CryptographicOperations.ZeroMemory(dek);

            var (requestId, error) = await AuthApi.RequestTenantProvisioningAsync(
                _tenantName, _tenantSlug, _adminEmail, authHash, encryptedDek, salt,
                kdfParams.MemoryKb, kdfParams.Iterations, kdfParams.Version,
                _legalName, _isBusiness, _addressLine, _city, _postalCode, _province, _country,
                vatNumber: _isBusiness ? _vatNumber : null,
                taxCode: _isBusiness ? null : _taxCode,
                sdiCode: string.IsNullOrWhiteSpace(_sdiCode) ? null : _sdiCode,
                pecAddress: string.IsNullOrWhiteSpace(_pecAddress) ? null : _pecAddress,
                phone: string.IsNullOrWhiteSpace(_phone) ? null : _phone);

            if (requestId is null)
            {
                _errorMessage = error;
                return;
            }

            _requestId = requestId;
            _step = Step.Confirm;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task HandleConfirmAsync()
    {
        if (_requestId is null)
        {
            return;
        }

        _errorMessage = null;
        _busy = true;
        try
        {
            var (success, error) = await AuthApi.ConfirmTenantProvisioningAsync(_requestId.Value, _code);
            if (!success)
            {
                _errorMessage = error;
                return;
            }

            _step = Step.Done;
        }
        finally
        {
            _busy = false;
        }
    }

    private void BackToForm()
    {
        _errorMessage = null;
        _code = string.Empty;
        _requestId = null;
        _step = Step.Form;
    }

    private static string Slugify(string name)
    {
        var builder = new System.Text.StringBuilder();
        bool lastWasDash = false;
        foreach (char c in name.Trim().ToLowerInvariant())
        {
            if (char.IsAsciiLetterOrDigit(c))
            {
                builder.Append(c);
                lastWasDash = false;
            }
            else if (!lastWasDash && builder.Length > 0)
            {
                builder.Append('-');
                lastWasDash = true;
            }
        }

        return builder.ToString().TrimEnd('-');
    }
}
