@page "/password-health"
@attribute [Authorize]
@using System.Text.Json
@using CffVaultManager.Crypto
@using CffVaultManager.Crypto.Abstractions
@using CffVaultManager.Web.Client.Models
@inject VaultApiClient VaultApi
@inject SessionState Session
@inject IAeadCipherService AeadCipher
@inject ItemKeyResolver ItemKeyResolver
@inject IPasswordStrengthService PasswordStrength
@inject IPasswordReuseService PasswordReuse
@inject IBreachCheckService BreachCheck

<PageTitle>Salute password</PageTitle>

<h1 class="h3 mb-2">Salute delle password</h1>
<p class="text-body-secondary">
    Ogni controllo (forza, riutilizzo, violazioni note) viene eseguito interamente su questo
    dispositivo dopo la decifratura: nessun dato sulle tue voci lascia mai il browser, nemmeno per
    segnalare che una password è compromessa — l'unica chiamata di rete è verso l'API k-anonymity
    di Have I Been Pwned, e invia solo i primi 5 caratteri dell'hash SHA-1 della password, mai la
    password né l'hash completo.
</p>

@if (_errorMessage is not null)
{
    <div class="alert alert-danger py-2" role="alert">@_errorMessage</div>
}

@if (_entries is null)
{
    <div class="d-flex align-items-center gap-2 text-body-secondary">
        <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
        <span>Caricamento e decifratura…</span>
    </div>
}
else
{
    <div class="row row-cols-2 row-cols-md-4 g-3 mb-4" style="max-width: 48rem;">
        <div class="col"><div class="card card-body text-center"><div class="h4 mb-0">@_entries.Count</div><div class="text-body-secondary small">Password analizzate</div></div></div>
        <div class="col"><div class="card card-body text-center"><div class="h4 mb-0">@_entries.Count(e => e.Strength.Level is PasswordStrengthLevel.VeryWeak or PasswordStrengthLevel.Weak)</div><div class="text-body-secondary small">Deboli</div></div></div>
        <div class="col"><div class="card card-body text-center"><div class="h4 mb-0">@_entries.Count(e => e.IsReused)</div><div class="text-body-secondary small">Riutilizzate</div></div></div>
        <div class="col"><div class="card card-body text-center"><div class="h4 mb-0">@_entries.Count(e => e.BreachCount is > 0)</div><div class="text-body-secondary small">Compromesse</div></div></div>
    </div>

    <div class="d-flex align-items-center gap-2 mb-3">
        <button type="button" class="btn btn-outline-secondary btn-sm" disabled="@_busy" @onclick="ReloadAsync">
            @if (_busy)
            {
                <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
            }
            Aggiorna
        </button>
        @if (_busy && _entries.Count > 0)
        {
            <span class="text-body-secondary small">Verifica violazioni note in corso: @_breachChecked/@_entries.Count</span>
        }
    </div>

    @if (_entries.Count == 0)
    {
        <p class="text-body-secondary">Nessuna voce di tipo Password trovata.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>Titolo</th>
                        <th>Vault</th>
                        <th>Forza</th>
                        <th>Riutilizzata</th>
                        <th>Violazioni note</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var entry in _entries.OrderByDescending(RiskScore))
                    {
                        <tr>
                            <td>@entry.Title</td>
                            <td>@entry.VaultName</td>
                            <td>
                                <span class="badge @StrengthCssClass(entry.Strength.Level)">@StrengthLabel(entry.Strength.Level)</span>
                            </td>
                            <td>
                                @if (entry.IsReused)
                                {
                                    <span class="badge text-bg-warning">Sì</span>
                                }
                                else
                                {
                                    <span class="text-body-secondary">No</span>
                                }
                            </td>
                            <td>
                                @if (entry.BreachCount is null)
                                {
                                    <span class="text-body-secondary">@(_busy ? "in corso…" : "sconosciuto")</span>
                                }
                                else if (entry.BreachCount > 0)
                                {
                                    <span class="badge text-bg-danger">Vista @entry.BreachCount volte in violazioni note</span>
                                }
                                else
                                {
                                    <span class="badge text-bg-success">Nessuna violazione nota</span>
                                }
                            </td>
                            <td><a class="btn btn-outline-secondary btn-sm" href="@($"/vault/{entry.VaultId}/items/{entry.ItemId}")">Apri</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

@code {
    private List<Entry>? _entries;
    private string? _errorMessage;
    private bool _busy;
    private int _breachChecked;

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        _errorMessage = null;
        _busy = true;
        _breachChecked = 0;
        StateHasChanged();

        try
        {
            var vaults = await VaultApi.ListVaultsAsync();
            byte[] dek = Session.RequireDek();

            var entries = new List<Entry>();
            foreach (var vault in vaults)
            {
                var items = await VaultApi.ListItemsAsync(vault.Id);
                foreach (var item in items.Where(i => i.Type == VaultItemTypes.Password))
                {
                    var decrypted = await TryDecryptAsync(item, dek);
                    if (decrypted is null)
                    {
                        continue;
                    }

                    entries.Add(new Entry(vault.Id, vault.Name, item.Id, decrypted.Title, decrypted.Password));
                }
            }

            var reusedItemIds = PasswordReuse
                .FindReusedGroups(entries.ToDictionary(e => e.ItemId, e => e.Password))
                .SelectMany(group => group)
                .ToHashSet();

            foreach (var entry in entries)
            {
                entry.Strength = PasswordStrength.EstimateStrength(entry.Password);
                entry.IsReused = reusedItemIds.Contains(entry.ItemId);
            }

            _entries = entries;
            StateHasChanged();

            // One HIBP lookup per distinct password value — reused passwords share a single check.
            var breachCountByPassword = new Dictionary<string, long?>(StringComparer.Ordinal);
            foreach (var entry in entries)
            {
                if (!breachCountByPassword.TryGetValue(entry.Password, out long? count))
                {
                    count = await TryCheckBreachAsync(entry.Password);
                    breachCountByPassword[entry.Password] = count;
                }

                entry.BreachCount = count;
                _breachChecked++;
                StateHasChanged();
            }
        }
        catch (HttpRequestException)
        {
            _errorMessage = "Impossibile caricare le voci del vault.";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task<DecryptedPassword?> TryDecryptAsync(VaultItemResponse item, byte[] dek)
    {
        try
        {
            byte[] key = item.MySharedAccess is { } access
                ? await ItemKeyResolver.UnwrapAsync(access.WrappedItemKey, access.EphemeralPublicKey)
                : dek;
            var blob = EncryptedBlob.FromBytes(item.EncryptedPayload);
            byte[] plaintext = AeadCipher.Decrypt(blob, key);
            var payload = JsonSerializer.Deserialize<PasswordPayload>(plaintext)!;
            return string.IsNullOrEmpty(payload.Password) ? null : new DecryptedPassword(payload.Title, payload.Password);
        }
        catch
        {
            // Wrong/rotated key, corrupted ciphertext, or an empty password — skip rather than
            // crash the whole scan over one bad item (same defensive style as VaultItems.razor).
            return null;
        }
    }

    private async Task<long?> TryCheckBreachAsync(string password)
    {
        try
        {
            return await BreachCheck.CheckPasswordAsync(password);
        }
        catch (HttpRequestException)
        {
            return null;
        }
    }

    private static double RiskScore(Entry entry) =>
        (entry.BreachCount is > 0 ? 100 : 0) + (entry.IsReused ? 10 : 0) - entry.Strength.EstimatedBitsOfEntropy;

    private static string StrengthLabel(PasswordStrengthLevel level) => level switch
    {
        PasswordStrengthLevel.VeryWeak => "Molto debole",
        PasswordStrengthLevel.Weak => "Debole",
        PasswordStrengthLevel.Fair => "Sufficiente",
        PasswordStrengthLevel.Strong => "Forte",
        PasswordStrengthLevel.VeryStrong => "Molto forte",
        _ => level.ToString(),
    };

    private static string StrengthCssClass(PasswordStrengthLevel level) => level switch
    {
        PasswordStrengthLevel.VeryWeak => "text-bg-danger",
        PasswordStrengthLevel.Weak => "text-bg-warning",
        PasswordStrengthLevel.Fair => "text-bg-warning",
        PasswordStrengthLevel.Strong => "text-bg-info",
        PasswordStrengthLevel.VeryStrong => "text-bg-success",
        _ => "text-bg-secondary",
    };

    private sealed record DecryptedPassword(string Title, string Password);

    private sealed class Entry(Guid vaultId, string vaultName, Guid itemId, string title, string password)
    {
        public Guid VaultId { get; } = vaultId;
        public string VaultName { get; } = vaultName;
        public Guid ItemId { get; } = itemId;
        public string Title { get; } = title;
        public string Password { get; } = password;
        public PasswordStrengthResult Strength { get; set; } = new(0, PasswordStrengthLevel.VeryWeak);
        public bool IsReused { get; set; }
        public long? BreachCount { get; set; }
    }
}
