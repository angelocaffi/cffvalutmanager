@page "/security"
@attribute [Authorize]
@using System.Security.Cryptography
@using CffVaultManager.Crypto
@using CffVaultManager.Crypto.Abstractions
@implements IDisposable
@inject AuthApiClient AuthApi
@inject WebAuthnJsInterop WebAuthn
@inject IDekService DekService
@inject IPasskeyDekWrapKeyService PasskeyDekWrapKey
@inject IRecoveryKeyService RecoveryKeyService
@inject SessionState Session
@inject ClipboardJsInterop Clipboard

<PageTitle>Sicurezza</PageTitle>

<h1 class="h3 mb-4">Sicurezza</h1>

@if (_profile is null)
{
    <div class="d-flex align-items-center gap-2 text-body-secondary">
        <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
        <span>Caricamento…</span>
    </div>
}
else
{
    <div class="card" style="max-width: 32rem;">
        <div class="card-body">
            <h2 class="h5">App authenticator (TOTP)</h2>
            <p class="text-body-secondary small">
                Genera codici monouso da un'app authenticator (es. Google Authenticator, Authy) come
                fattore aggiuntivo insieme alla master password. Non richiede rete né dipende dalla
                tua casella email — è il fattore consigliato.
            </p>

            @if (_totpError is not null)
            {
                <div class="alert alert-danger py-2" role="alert">@_totpError</div>
            }

            @if (_profile.MfaEnabled)
            {
                <p class="mb-3"><span class="badge text-bg-success">Abilitato</span></p>
                <button type="button" class="btn btn-outline-danger" disabled="@_totpBusy" @onclick="DisableTotpAsync">
                    @if (_totpBusy)
                    {
                        <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                    }
                    Disabilita
                </button>
            }
            else if (_totpProvisioningUri is not null)
            {
                <div class="d-flex flex-column align-items-start gap-2 mb-3">
                    <div class="border rounded p-2 bg-white" style="width: 11rem;">
                        @((MarkupString)_totpQrSvg!)
                    </div>
                    @if (_totpSecret is not null)
                    {
                        <p class="small text-body-secondary mb-0">
                            Non riesci a inquadrare il QR code? Inserisci questo codice manualmente nell'app:
                            <span class="font-monospace user-select-all d-block">@_totpSecret</span>
                        </p>
                    }
                </div>

                <div class="input-group mb-3" style="max-width: 16rem;">
                    <input type="text" class="form-control" placeholder="Codice a 6 cifre" inputmode="numeric"
                           autocomplete="one-time-code" @bind="_totpCode" @bind:event="oninput" disabled="@_totpBusy" />
                    <button type="button" class="btn btn-info" disabled="@(_totpBusy || string.IsNullOrWhiteSpace(_totpCode))" @onclick="ConfirmTotpAsync">
                        @if (_totpBusy)
                        {
                            <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                        }
                        Conferma
                    </button>
                </div>
            }
            else
            {
                <p class="mb-3"><span class="badge text-bg-secondary">Disabilitato</span></p>
                <button type="button" class="btn btn-info" disabled="@_totpBusy" @onclick="BeginTotpSetupAsync">
                    @if (_totpBusy)
                    {
                        <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                    }
                    Configura app authenticator
                </button>
            }
        </div>
    </div>

    <div class="card mt-3" style="max-width: 32rem;">
        <div class="card-body">
            <h2 class="h5">Email OTP come fattore MFA</h2>
            <p class="text-body-secondary small">
                Quando abilitato, in aggiunta alla master password ti verrà richiesto un codice inviato
                alla tua email (@_profile.Email) per completare l'accesso. Rispetto all'app authenticator
                (TOTP) è considerato un fattore <strong>meno sicuro</strong>, perché dipende dal controllo
                della casella email.
            </p>

            @if (!_profile.EmailVerified)
            {
                <div class="alert alert-warning py-2" role="alert">
                    Devi prima verificare il tuo indirizzo email prima di poter abilitare questo fattore.
                </div>
            }

            @if (_errorMessage is not null)
            {
                <div class="alert alert-danger py-2" role="alert">@_errorMessage</div>
            }

            @if (_profile.MfaEmailOtpEnabled)
            {
                <p class="mb-3"><span class="badge text-bg-success">Abilitato</span></p>
                <button type="button" class="btn btn-outline-danger" disabled="@_busy" @onclick="DisableAsync">
                    @if (_busy)
                    {
                        <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                    }
                    Disabilita
                </button>
            }
            else
            {
                <p class="mb-3"><span class="badge text-bg-secondary">Disabilitato</span></p>
                <button type="button" class="btn btn-info" disabled="@(_busy || !_profile.EmailVerified)" @onclick="EnableAsync">
                    @if (_busy)
                    {
                        <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                    }
                    Abilita
                </button>
            }
        </div>
    </div>

    <div class="card mt-3" style="max-width: 32rem;">
        <div class="card-body">
            <h2 class="h5">Chiavi di sicurezza e biometria (WebAuthn)</h2>
            <p class="text-body-secondary small">
                Registra un dispositivo (impronta digitale, volto, o una chiave di sicurezza fisica)
                da usare come fattore aggiuntivo insieme alla master password. Puoi registrarne più
                di uno.
            </p>

            @if (!_webAuthnAvailable)
            {
                <div class="alert alert-warning py-2" role="alert">Il tuo browser non supporta WebAuthn.</div>
            }

            @if (_webAuthnError is not null)
            {
                <div class="alert alert-danger py-2" role="alert">@_webAuthnError</div>
            }

            @if (_webAuthnInfo is not null)
            {
                <div class="alert alert-warning py-2" role="alert">@_webAuthnInfo</div>
            }

            @if (_credentials is null)
            {
                <div class="d-flex align-items-center gap-2 text-body-secondary mb-3">
                    <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                    <span>Caricamento…</span>
                </div>
            }
            else if (_credentials.Count == 0)
            {
                <EmptyState Message="Nessun dispositivo registrato." Compact="true" />
            }
            else
            {
                <ul class="list-group mb-3">
                    @foreach (var credential in _credentials)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <span>@(credential.Nickname ?? "Dispositivo senza nome")</span>
                            <button type="button" class="btn btn-outline-danger btn-sm" disabled="@_webAuthnBusy"
                                    @onclick="() => RemoveCredentialAsync(credential.Id)">
                                Rimuovi
                            </button>
                        </li>
                    }
                </ul>
            }

            <div class="input-group mb-2" style="max-width: 32rem;">
                <input type="text" class="form-control" placeholder="Nome dispositivo (opzionale)"
                       @bind="_newCredentialNickname" @bind:event="oninput" disabled="@_webAuthnBusy" />
                <button type="button" class="btn btn-info" disabled="@(_webAuthnBusy || !_webAuthnAvailable)" @onclick="RegisterCredentialAsync">
                    @if (_webAuthnBusy)
                    {
                        <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                    }
                    Registra dispositivo
                </button>
            </div>

            <p class="text-body-secondary small mb-2">
                In alternativa, attiva l'accesso <strong>senza digitare la master password</strong> su
                questo dispositivo: al prossimo accesso basterà il sensore biometrico. Richiede una
                nuova registrazione dedicata (le passkey registrate sopra come fattore di sicurezza
                non diventano automaticamente utilizzabili per questo) e non è supportato da ogni
                browser/dispositivo — in quel caso il dispositivo viene comunque registrato come
                normale fattore di sicurezza.
            </p>
            <button type="button" class="btn btn-outline-info" disabled="@(_webAuthnBusy || !_webAuthnAvailable)" @onclick="RegisterPasswordlessCredentialAsync">
                @if (_webAuthnBusy)
                {
                    <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                }
                Attiva accesso senza password su questo dispositivo
            </button>
        </div>
    </div>

    <div class="card mt-3" style="max-width: 32rem;">
        <div class="card-body">
            <h2 class="h5">Kit di recupero</h2>
            <p class="text-body-secondary small">
                Una chiave di recupero opzionale, indipendente dalla master password, per non perdere
                l'accesso al vault se la dimentichi. Viene mostrata <strong>una sola volta</strong>: va
                salvata offline (stampa, cassaforte). Chiunque la possieda, insieme alla tua email, può
                bypassare la master password — trattala con la stessa cura.
            </p>

            @if (_recoveryError is not null)
            {
                <div class="alert alert-danger py-2" role="alert">@_recoveryError</div>
            }

            @if (_revealedRecoveryKey is not null)
            {
                <div class="alert alert-warning py-2">
                    <p class="fw-semibold mb-2">Salva questa chiave ora — non verrà mostrata di nuovo.</p>
                    <p class="font-monospace user-select-all mb-2">@_revealedRecoveryKey</p>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="CopyRecoveryKeyAsync">Copia</button>
                        <button type="button" class="btn btn-info btn-sm" @onclick="DismissRevealedKey">Ho salvato la chiave</button>
                    </div>
                </div>
            }
            else if (_profile!.HasRecoveryKit)
            {
                <p class="mb-3">
                    <span class="badge text-bg-success">Attivo</span>
                    <span class="text-body-secondary small ms-1">generato il @_profile.RecoveryKitGeneratedAt?.LocalDateTime.ToString("g")</span>
                </p>

                @if (_confirmRegenerate)
                {
                    <div class="alert alert-warning py-2 d-flex flex-wrap justify-content-between align-items-center gap-2">
                        <span>Il kit attuale smetterà di funzionare. Continuare?</span>
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-danger btn-sm" disabled="@_recoveryBusy" @onclick="GenerateRecoveryKitAsync">Sì, rigenera</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm" disabled="@_recoveryBusy" @onclick="() => _confirmRegenerate = false">Annulla</button>
                        </div>
                    </div>
                }
                else
                {
                    <button type="button" class="btn btn-outline-danger" disabled="@_recoveryBusy" @onclick="() => _confirmRegenerate = true">
                        Rigenera
                    </button>
                }
            }
            else
            {
                @if (_profile!.RecoveryKitGeneratedAt is not null)
                {
                    <p class="mb-3"><span class="badge text-bg-warning">Non più valido</span>
                        <span class="text-body-secondary small ms-1">il kit precedente non è più utilizzabile — generane uno nuovo</span>
                    </p>
                }
                else
                {
                    <p class="mb-3"><span class="badge text-bg-secondary">Nessuno</span></p>
                }

                <button type="button" class="btn btn-info" disabled="@_recoveryBusy" @onclick="GenerateRecoveryKitAsync">
                    @if (_recoveryBusy)
                    {
                        <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                    }
                    Genera kit di recupero
                </button>
            }
        </div>
    </div>
}

@code {
    private UserProfileResponse? _profile;
    private bool _busy;
    private string? _errorMessage;

    private IReadOnlyList<WebAuthnCredentialResponse>? _credentials;
    private bool _webAuthnAvailable;
    private bool _webAuthnBusy;
    private string? _webAuthnError;
    private string? _webAuthnInfo;
    private string _newCredentialNickname = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await ReloadProfileAsync();
        _webAuthnAvailable = await WebAuthn.IsAvailableAsync();
        await ReloadCredentialsAsync();
    }

    private async Task ReloadCredentialsAsync() => _credentials = await AuthApi.ListWebAuthnCredentialsAsync();

    private async Task RegisterCredentialAsync()
    {
        _webAuthnError = null;
        _webAuthnInfo = null;
        _webAuthnBusy = true;
        try
        {
            string optionsJson = await AuthApi.BeginWebAuthnRegistrationAsync();
            string? attestationResponseJson = await WebAuthn.RegisterAsync(optionsJson);
            if (attestationResponseJson is null)
            {
                _webAuthnError = "Registrazione annullata o non riuscita.";
                return;
            }

            string? nickname = string.IsNullOrWhiteSpace(_newCredentialNickname) ? null : _newCredentialNickname;
            var (success, error) = await AuthApi.CompleteWebAuthnRegistrationAsync(attestationResponseJson, nickname);
            if (!success)
            {
                _webAuthnError = error;
                return;
            }

            _newCredentialNickname = string.Empty;
            await ReloadCredentialsAsync();
        }
        finally
        {
            _webAuthnBusy = false;
        }
    }

    /// <summary>
    /// Registers a new, discoverable passkey with the WebAuthn PRF extension and wraps the
    /// caller's own already-unlocked DEK with a key derived from it — see
    /// docs/security-model.md#sblocco-senza-password-via-passkey-webauthn-prf. The PRF output
    /// never leaves this method; only the resulting ciphertext is sent to the server.
    /// </summary>
    private async Task RegisterPasswordlessCredentialAsync()
    {
        _webAuthnError = null;
        _webAuthnInfo = null;
        _webAuthnBusy = true;
        try
        {
            string optionsJson = await AuthApi.BeginWebAuthnRegistrationAsync(enablePasswordless: true);
            var (responseJson, prfOutput) = await WebAuthn.RegisterWithPrfAsync(optionsJson);
            if (responseJson is null)
            {
                _webAuthnError = "Registrazione annullata o non riuscita.";
                return;
            }

            byte[]? prfWrappedDek = null;
            if (prfOutput is null)
            {
                _webAuthnInfo = "Questo dispositivo/browser non supporta l'accesso senza password: il dispositivo verrà comunque registrato come normale fattore di sicurezza.";
            }
            else
            {
                byte[] prfKek = PasskeyDekWrapKey.DeriveKey(prfOutput);
                try
                {
                    prfWrappedDek = DekService.EncryptDek(Session.RequireDek(), prfKek).ToBytes();
                }
                finally
                {
                    CryptographicOperations.ZeroMemory(prfKek);
                }
            }

            string? nickname = string.IsNullOrWhiteSpace(_newCredentialNickname) ? null : _newCredentialNickname;
            var (success, error) = await AuthApi.CompleteWebAuthnRegistrationAsync(responseJson, nickname, prfWrappedDek);
            if (!success)
            {
                _webAuthnError = error;
                return;
            }

            _newCredentialNickname = string.Empty;
            await ReloadCredentialsAsync();
        }
        finally
        {
            _webAuthnBusy = false;
        }
    }

    private async Task RemoveCredentialAsync(Guid credentialId)
    {
        _webAuthnError = null;
        _webAuthnBusy = true;
        try
        {
            await AuthApi.RemoveWebAuthnCredentialAsync(credentialId);
            await ReloadCredentialsAsync();
        }
        finally
        {
            _webAuthnBusy = false;
        }
    }

    private async Task ReloadProfileAsync() => _profile = await AuthApi.GetProfileAsync();

    // ---- TOTP (authenticator app) MFA setup ------------------------------------------------------

    private bool _totpBusy;
    private string? _totpError;
    private string? _totpProvisioningUri;
    private string? _totpQrSvg;
    private string? _totpSecret;
    private string _totpCode = string.Empty;

    private async Task BeginTotpSetupAsync()
    {
        _totpError = null;
        _totpBusy = true;
        try
        {
            _totpProvisioningUri = await AuthApi.BeginTotpSetupAsync();
            _totpQrSvg = TotpQrCodeRenderer.ToSvg(_totpProvisioningUri);
            _totpSecret = TotpQrCodeRenderer.ExtractSecret(_totpProvisioningUri);
        }
        finally
        {
            _totpBusy = false;
        }
    }

    private async Task ConfirmTotpAsync()
    {
        _totpError = null;
        _totpBusy = true;
        try
        {
            bool confirmed = await AuthApi.ConfirmTotpSetupAsync(_totpCode);
            if (!confirmed)
            {
                _totpError = "Codice non valido. Riprova.";
                return;
            }

            _totpProvisioningUri = null;
            _totpQrSvg = null;
            _totpSecret = null;
            _totpCode = string.Empty;
            await ReloadProfileAsync();
        }
        finally
        {
            _totpBusy = false;
        }
    }

    private async Task DisableTotpAsync()
    {
        _totpError = null;
        _totpBusy = true;
        try
        {
            await AuthApi.DisableTotpAsync();
            await ReloadProfileAsync();
        }
        finally
        {
            _totpBusy = false;
        }
    }

    private async Task EnableAsync()
    {
        _errorMessage = null;
        _busy = true;
        try
        {
            var (success, error) = await AuthApi.EnableEmailOtpMfaAsync();
            if (!success)
            {
                _errorMessage = error;
                return;
            }

            await ReloadProfileAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DisableAsync()
    {
        _errorMessage = null;
        _busy = true;
        try
        {
            await AuthApi.DisableEmailOtpMfaAsync();
            await ReloadProfileAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    // ---- Recovery kit (see docs/security-model.md#recovery-kit) --------------------------------

    private bool _recoveryBusy;
    private string? _recoveryError;
    private bool _confirmRegenerate;

    // Held only long enough to display and let the user copy it; zeroed as soon as the reveal
    // panel is dismissed or the component is torn down — same discipline as Login.razor's _pendingKek.
    private byte[]? _pendingRecoveryKeyBytes;
    private string? _revealedRecoveryKey;

    private async Task GenerateRecoveryKitAsync()
    {
        _recoveryError = null;
        _confirmRegenerate = false;
        _recoveryBusy = true;
        try
        {
            byte[] dek = Session.RequireDek();
            byte[] recoveryKey = RecoveryKeyService.GenerateRecoveryKey();
            byte[] recoveryEncryptedDek = DekService.EncryptDek(dek, recoveryKey).ToBytes();
            byte[] recoveryAuthHash = RecoveryKeyService.DeriveRecoveryAuthHash(recoveryKey);

            var (success, error) = await AuthApi.GenerateRecoveryKitAsync(recoveryEncryptedDek, recoveryAuthHash);
            if (!success)
            {
                CryptographicOperations.ZeroMemory(recoveryKey);
                _recoveryError = error;
                return;
            }

            _pendingRecoveryKeyBytes = recoveryKey;
            _revealedRecoveryKey = RecoveryKeyFormatter.Format(recoveryKey);
            await ReloadProfileAsync();
        }
        finally
        {
            _recoveryBusy = false;
        }
    }

    private async Task CopyRecoveryKeyAsync()
    {
        if (_revealedRecoveryKey is not null)
        {
            await Clipboard.CopyWithAutoClearAsync(_revealedRecoveryKey, TimeSpan.FromSeconds(60));
        }
    }

    private void DismissRevealedKey()
    {
        if (_pendingRecoveryKeyBytes is not null)
        {
            CryptographicOperations.ZeroMemory(_pendingRecoveryKeyBytes);
            _pendingRecoveryKeyBytes = null;
        }

        _revealedRecoveryKey = null;
    }

    public void Dispose() => DismissRevealedKey();
}
