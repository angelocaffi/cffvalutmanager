@page "/login"
@using System.Security.Cryptography
@using CffVaultManager.Crypto
@using CffVaultManager.Crypto.Abstractions
@implements IDisposable
@inject AuthApiClient AuthApi
@inject IKeyDerivationService KeyDerivation
@inject IAuthHashService AuthHashService
@inject IDekService DekService
@inject SessionState Session
@inject NavigationManager Navigation
@inject WebAuthnJsInterop WebAuthn

<PageTitle>Accedi</PageTitle>

<div class="login-shell d-flex justify-content-center">
    <div class="card shadow-sm login-card">
        <div class="card-body p-4">
            <div class="text-center mb-4">
                <img src="/CffVaultmanager.svg" alt="CffVaultManager" class="login-logo mb-2" />
                <h1 class="h4 mb-0 text-primary">Accedi al tuo vault</h1>
            </div>

            @if (_stage == Stage.Credentials)
            {
                <form @onsubmit="HandleCredentialsSubmitAsync" @onsubmit:preventDefault="true">
                    <div class="mb-3">
                        <label for="login-email" class="form-label">Email</label>
                        <input id="login-email" type="email" class="form-control" @bind="_email" @bind:event="oninput"
                               required disabled="@_busy" autocomplete="username" />
                    </div>
                    <div class="mb-3">
                        <label for="login-password" class="form-label">Master password</label>
                        <input id="login-password" type="password" class="form-control" @bind="_masterPassword" @bind:event="oninput"
                               required disabled="@_busy" autocomplete="current-password" />
                    </div>

                    @if (_errorMessage is not null)
                    {
                        <div class="alert alert-danger py-2" role="alert">@_errorMessage</div>
                    }

                    <button type="submit" class="btn btn-info w-100" disabled="@_busy">
                        @if (_busy)
                        {
                            <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                        }
                        @(_busy ? "Accesso in corso…" : "Accedi")
                    </button>
                </form>

                <p class="text-center small text-body-secondary mt-3 mb-0">
                    Non hai un'organizzazione? <a href="/register">Creane una</a>
                </p>
            }
            else if (_selectedFactor is null)
            {
                <p class="text-body-secondary small">Scegli come completare l'accesso.</p>

                @if (_errorMessage is not null)
                {
                    <div class="alert alert-danger py-2" role="alert">@_errorMessage</div>
                }

                <div class="d-grid gap-2">
                    @if (_availableFactors.Contains("WebAuthn"))
                    {
                        <button type="button" class="btn btn-outline-info" @onclick='() => SelectFactorAsync("WebAuthn")'>
                            Chiave di sicurezza o impronta/volto
                        </button>
                    }
                    @if (_availableFactors.Contains("Totp"))
                    {
                        <button type="button" class="btn btn-outline-info" @onclick='() => SelectFactorAsync("Totp")'>
                            App authenticator (TOTP)
                        </button>
                    }
                    @if (_availableFactors.Contains("EmailOtp"))
                    {
                        <button type="button" class="btn btn-outline-info" @onclick='() => SelectFactorAsync("EmailOtp")'>
                            Codice via email <span class="badge text-bg-secondary">meno sicuro</span>
                        </button>
                    }
                </div>
            }
            else if (_selectedFactor == "WebAuthn")
            {
                <p class="text-body-secondary small">
                    @(_busy
                        ? "Segui le istruzioni del browser per verificare la tua identità (impronta, volto o chiave di sicurezza)."
                        : "Verifica non riuscita o annullata.")
                </p>

                @if (_errorMessage is not null)
                {
                    <div class="alert alert-danger py-2" role="alert">@_errorMessage</div>
                }

                <button type="button" class="btn btn-info w-100 mb-2" disabled="@_busy" @onclick="StartWebAuthnAsync">
                    @if (_busy)
                    {
                        <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                    }
                    @(_busy ? "Verifica in corso…" : "Riprova")
                </button>

                @if (_availableFactors.Count > 1)
                {
                    <button type="button" class="btn btn-link btn-sm w-100" disabled="@_busy" @onclick="ResetFactorSelection">
                        Usa un altro metodo
                    </button>
                }
            }
            else
            {
                <form @onsubmit="HandleMfaSubmitAsync" @onsubmit:preventDefault="true">
                    @if (_selectedFactor == "EmailOtp")
                    {
                        <p class="text-body-secondary small">
                            @if (_codeExpirySeconds is null)
                            {
                                <span>Invio del codice in corso…</span>
                            }
                            else if (_codeExpirySeconds > 0)
                            {
                                <span>Ti abbiamo inviato un codice via email. Inseriscilo qui sotto. Scade tra @FormatCountdown(_codeExpirySeconds.Value).</span>
                            }
                            else
                            {
                                <span>Il codice è scaduto: inviane uno nuovo.</span>
                            }
                        </p>
                    }
                    else
                    {
                        <p class="text-body-secondary small">Inserisci il codice a 6 cifre della tua app di autenticazione.</p>
                    }

                    <div class="mb-3">
                        <label for="login-mfa-code" class="form-label">Codice</label>
                        <input id="login-mfa-code" type="text" class="form-control" inputmode="numeric" autocomplete="one-time-code" maxlength="6"
                               @bind="_mfaCode" @bind:event="oninput" required disabled="@_busy" />
                    </div>

                    @if (_errorMessage is not null)
                    {
                        <div class="alert alert-danger py-2" role="alert">@_errorMessage</div>
                    }

                    <button type="submit" class="btn btn-info w-100 mb-2" disabled="@_busy">
                        @if (_busy)
                        {
                            <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                        }
                        @(_busy ? "Verifica in corso…" : "Verifica")
                    </button>

                    @if (_selectedFactor == "EmailOtp")
                    {
                        <button type="button" class="btn btn-link btn-sm w-100" disabled="@(_busy || _resendCooldownSeconds > 0)"
                                @onclick="() => SendEmailOtpAsync()">
                            @(_resendCooldownSeconds > 0 ? $"Reinvia tra {_resendCooldownSeconds}s" : "Invia di nuovo")
                        </button>
                    }

                    @if (_availableFactors.Count > 1)
                    {
                        <button type="button" class="btn btn-link btn-sm w-100" disabled="@_busy" @onclick="ResetFactorSelection">
                            Usa un altro metodo
                        </button>
                    }
                </form>
            }
        </div>
    </div>
</div>

@code {
    private enum Stage { Credentials, Mfa }

    private Stage _stage = Stage.Credentials;
    private string _email = string.Empty;
    private string _masterPassword = string.Empty;
    private string _mfaCode = string.Empty;
    private string? _errorMessage;
    private bool _busy;
    private string? _returnUrl;

    private IReadOnlyList<string> _availableFactors = Array.Empty<string>();
    private string? _selectedFactor;
    private int _resendCooldownSeconds;

    // Null until the first send actually completes — distinct from 0 (which means "sent, then
    // expired"), so the UI can show "sending…" instead of wrongly claiming an expired code that
    // was never sent in the first place.
    private int? _codeExpirySeconds;
    private Timer? _countdownTimer;

    private const int ResendCooldownSeconds = 60;
    private const int CodeExpirySeconds = 600;

    // Kept only for the short window between the two login steps (an MFA challenge); never
    // persisted anywhere, and zeroed as soon as it's no longer needed.
    private byte[]? _pendingKek;
    private string? _pendingChallengeToken;

    [Parameter]
    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrlQuery { get; set; }

    protected override void OnInitialized() => _returnUrl = ReturnUrlQuery;

    private async Task HandleCredentialsSubmitAsync()
    {
        _errorMessage = null;
        _busy = true;
        try
        {
            var prelogin = await AuthApi.PreloginAsync(_email);
            var kdfParams = new Argon2Parameters(prelogin.KdfMemoryKb, prelogin.KdfIterations, version: prelogin.KdfVersion);

            using var kek = await KeyDerivation.DeriveKekAsync(_masterPassword, prelogin.MasterPasswordSalt, kdfParams);
            byte[] authHash = AuthHashService.DeriveAuthHash(kek, _masterPassword);

            var result = await AuthApi.LoginAsync(_email, authHash);

            if (result.RequiresMfa)
            {
                _pendingKek = kek.Key.ToArray();
                _pendingChallengeToken = result.MfaChallengeToken;
                _availableFactors = result.AvailableMfaFactors ?? Array.Empty<string>();
                _stage = Stage.Mfa;

                // Only one factor registered: skip the chooser and go straight to it (sending the
                // Email OTP code immediately, since — unlike TOTP — there is nothing to enter yet).
                if (_availableFactors.Count == 1)
                {
                    await SelectFactorAsync(_availableFactors[0]);
                }

                return;
            }

            if (!result.Success || result.AccessToken is null || result.RefreshToken is null || result.CryptoMaterials is null)
            {
                _errorMessage = "Email o master password errati.";
                return;
            }

            CompleteLogin(result, kek.Key);
        }
        finally
        {
            _masterPassword = string.Empty;
            _busy = false;
        }
    }

    private async Task SelectFactorAsync(string factor)
    {
        _errorMessage = null;
        _mfaCode = string.Empty;
        _selectedFactor = factor;

        if (factor == "EmailOtp")
        {
            await SendEmailOtpAsync();
        }
        else if (factor == "WebAuthn")
        {
            await StartWebAuthnAsync();
        }
    }

    private async Task StartWebAuthnAsync()
    {
        if (_pendingChallengeToken is null)
        {
            return;
        }

        _errorMessage = null;
        _busy = true;
        try
        {
            string? optionsJson = await AuthApi.BeginWebAuthnAssertionAsync(_pendingChallengeToken);
            if (optionsJson is null)
            {
                _errorMessage = "Impossibile avviare la verifica. Riprova ad accedere.";
                return;
            }

            string? assertionResponseJson = await WebAuthn.AuthenticateAsync(optionsJson);
            if (assertionResponseJson is null)
            {
                _errorMessage = "Verifica annullata o non riuscita.";
                return;
            }

            var result = await AuthApi.CompleteWebAuthnAssertionAsync(_pendingChallengeToken, assertionResponseJson);
            if (!result.Success || result.AccessToken is null || result.RefreshToken is null
                || result.CryptoMaterials is null || _pendingKek is null)
            {
                _errorMessage = "Verifica non riuscita.";
                return;
            }

            CompleteLogin(result, _pendingKek);
            ClearPendingKek();
        }
        finally
        {
            _busy = false;
        }
    }

    private void ResetFactorSelection()
    {
        StopCountdown();
        _selectedFactor = null;
        _mfaCode = string.Empty;
        _errorMessage = null;
        _resendCooldownSeconds = 0;
        _codeExpirySeconds = null;
    }

    // Zeroes and drops the in-memory KEK. Called only once the MFA step is truly done — a
    // completed login, or the component being torn down (navigating away mid-flow) — never after
    // a merely wrong code/failed assertion, which must still allow further attempts up to the
    // server's own lockout (docs/features/authentication.md). The KEK itself doesn't depend on
    // which second factor completes it, so switching factors via "Usa un altro metodo" keeps it.
    private void ClearPendingKek()
    {
        if (_pendingKek is not null)
        {
            CryptographicOperations.ZeroMemory(_pendingKek);
            _pendingKek = null;
        }
    }

    private async Task SendEmailOtpAsync()
    {
        if (_pendingChallengeToken is null)
        {
            return;
        }

        _busy = true;
        try
        {
            bool sent = await AuthApi.SendMfaEmailOtpAsync(_pendingChallengeToken);
            if (!sent)
            {
                _errorMessage = "Impossibile inviare il codice. Riprova ad accedere.";
                return;
            }

            _resendCooldownSeconds = ResendCooldownSeconds;
            _codeExpirySeconds = CodeExpirySeconds;
            StartCountdown();
        }
        finally
        {
            _busy = false;
        }
    }

    private void StartCountdown()
    {
        _countdownTimer ??= new Timer(_ => InvokeAsync(TickCountdown), null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
    }

    private void StopCountdown()
    {
        _countdownTimer?.Dispose();
        _countdownTimer = null;
    }

    private void TickCountdown()
    {
        if (_resendCooldownSeconds > 0)
        {
            _resendCooldownSeconds--;
        }

        if (_codeExpirySeconds is > 0)
        {
            _codeExpirySeconds--;
        }

        if (_resendCooldownSeconds == 0 && _codeExpirySeconds == 0)
        {
            StopCountdown();
        }

        StateHasChanged();
    }

    private static string FormatCountdown(int totalSeconds) =>
        $"{totalSeconds / 60}:{totalSeconds % 60:D2}";

    private async Task HandleMfaSubmitAsync()
    {
        if (_pendingKek is null || _pendingChallengeToken is null || _selectedFactor is null)
        {
            // Lost the in-memory KEK (e.g. the page was reloaded mid-flow) — nothing to unwrap
            // the DEK with, so start over rather than get stuck on a form that can't succeed.
            _stage = Stage.Credentials;
            return;
        }

        _errorMessage = null;
        _busy = true;
        try
        {
            var result = await AuthApi.VerifyMfaAsync(_pendingChallengeToken, _mfaCode, _selectedFactor);

            if (!result.Success || result.AccessToken is null || result.RefreshToken is null || result.CryptoMaterials is null)
            {
                _errorMessage = "Codice non valido.";
                return;
            }

            CompleteLogin(result, _pendingKek);
            ClearPendingKek();
        }
        finally
        {
            _mfaCode = string.Empty;
            _busy = false;
        }
    }

    private void CompleteLogin(LoginResponse result, ReadOnlySpan<byte> kek)
    {
        StopCountdown();
        var wrappedDek = EncryptedBlob.FromBytes(result.CryptoMaterials!.EncryptedDek);
        byte[] dek = DekService.DecryptDek(wrappedDek, kek);

        var (userId, tenantId, role) = JwtParser.ParseAccessToken(result.AccessToken!);
        Session.Establish(result.AccessToken!, result.RefreshToken!, dek, _email, userId, tenantId, role);

        Navigation.NavigateTo(string.IsNullOrEmpty(_returnUrl) ? "/vault" : _returnUrl);
    }

    public void Dispose()
    {
        StopCountdown();
        ClearPendingKek();
    }
}
